<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DataRecon Platform</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/enterprise.css" />
</head>
<body>

    @* ── Top navigation bar ──────────────────────────────────────────────── *@
    <nav class="navbar navbar-expand-md navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Workflow" asp-action="Index">
                <i class="fas fa-layer-group me-2"></i>DataRecon Platform
            </a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Workflow" asp-action="Create">
                            <i class="fas fa-plus me-1"></i>New Job
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid p-0">
        <div class="row g-0">

            @* ── Sidebar ─────────────────────────────────────────────────── *@
            @{
                var ctrl   = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                var action = ViewContext.RouteData.Values["action"]?.ToString()     ?? "";

                string NavCls(string c, string? a = null) =>
                    ctrl.Equals(c, StringComparison.OrdinalIgnoreCase) &&
                    (a == null || action.Equals(a, StringComparison.OrdinalIgnoreCase))
                        ? "nav-link active" : "nav-link";
            }

            <div class="col-md-2 sidebar">
                <nav class="d-flex flex-column h-100 py-2">

                    <span class="sidebar-section-label">Workspace</span>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="@NavCls("Workflow","Index")" asp-controller="Workflow" asp-action="Index">
                                <i class="fas fa-tachometer-alt"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavCls("Workflow","Create")" asp-controller="Workflow" asp-action="Create">
                                <i class="fas fa-upload"></i>New Workflow
                            </a>
                        </li>
                    </ul>

                    <div class="sidebar-divider"></div>

                    <span class="sidebar-section-label">Tools</span>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="@NavCls("SchemaGenerator")" asp-controller="SchemaGenerator" asp-action="Index">
                                <i class="fas fa-table-columns"></i>Schema Generator
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavCls("Mainframe")" asp-controller="Mainframe" asp-action="Index">
                                <i class="fas fa-terminal"></i>Mainframe Artifacts
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavCls("Reports")" asp-controller="Reports" asp-action="Index">
                                <i class="fas fa-chart-bar"></i>Reports
                            </a>
                        </li>
                    </ul>

                    <div class="sidebar-divider mt-auto"></div>

                    <ul class="nav flex-column pb-2">
                        <li class="nav-item">
                            <a class="@NavCls("Settings")" asp-controller="Settings" asp-action="Index">
                                <i class="fas fa-sliders-h"></i>AI Settings
                            </a>
                        </li>
                    </ul>

                </nav>
            </div>

            @* ── Main content ─────────────────────────────────────────────── *@
            <div class="col-md-10 main-content">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                        <i class="fas fa-circle-check me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
