@model DataReconciliation.Application.DTOs.GovernanceDashboardViewModel
@using DataReconciliation.Domain.Models
@{
    ViewData["Title"] = "AI Governance — " + Model.JobId;
    var ev   = Model.Evaluation;
    var log  = Model.AuditLog;
    var ai   = Model.AiAudits;

    // ── Readiness score colour ──────────────────────────────────────────────────
    string ReadinessColour(double score) => score >= 80 ? "success" : score >= 50 ? "warning" : "danger";
    string PctColour(double pct) => pct >= 80 ? "success" : pct >= 50 ? "warning" : "danger";
}

@* ── Page header ─────────────────────────────────────────────────────────────── *@
<div class="d-flex align-items-center mb-4">
    <a asp-controller="Workflow" asp-action="Details" asp-route-jobId="@Model.JobId"
       class="btn btn-outline-secondary me-3">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h2 class="mb-0"><i class="fas fa-shield-halved me-2 text-primary"></i>AI Governance Dashboard</h2>
        <div class="text-muted small mt-1">
            <strong>@Model.JobName</strong> &nbsp;·&nbsp; <code>@Model.JobId</code>
            @if (log != null)
            {
                <span class="ms-2">Reviewer: <strong>@log.ReviewerName</strong></span>
            }
        </div>
    </div>
    @if (ev != null)
    {
        <div class="ms-auto text-end">
            <div class="fs-5 fw-bold text-@ReadinessColour(ev.MappingReadinessScore)">
                @ev.MappingReadinessScore.ToString("F1")
            </div>
            <div class="small text-muted">Readiness Score</div>
        </div>
    }
    <form asp-action="RecomputeEvaluation" method="post" class="ms-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="jobId" value="@Model.JobId" />
        <button type="submit" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-sync me-1"></i>Recompute
        </button>
    </form>
</div>

@if (ev == null)
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>
        No evaluation summary found. Complete the workflow (Step 14 — Reporting &amp; Audit Generation) to populate this dashboard.
    </div>
}

@* ── Tabs ─────────────────────────────────────────────────────────────────────── *@
<ul class="nav nav-tabs mb-4" id="govTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="quality-tab" data-bs-toggle="tab" data-bs-target="#quality"
                type="button" role="tab">
            <i class="fas fa-star me-1"></i>Quality &amp; Governance
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="cost-tab" data-bs-toggle="tab" data-bs-target="#cost"
                type="button" role="tab">
            <i class="fas fa-coins me-1"></i>Cost &amp; Usage
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="audittrail-tab" data-bs-toggle="tab" data-bs-target="#audittrail"
                type="button" role="tab">
            <i class="fas fa-list-check me-1"></i>Audit Trail
            @if (log?.Entries.Any() == true)
            {
                <span class="badge bg-secondary ms-1">@log.Entries.Count</span>
            }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history"
                type="button" role="tab">
            <i class="fas fa-clock-rotate-left me-1"></i>Run History
            @if (Model.RunHistory.Runs.Any())
            {
                <span class="badge bg-secondary ms-1">@Model.RunHistory.Runs.Count</span>
            }
        </button>
    </li>
</ul>

<div class="tab-content" id="govTabContent">

    @* ══════════════════════════════════════════════════════════════════════════ *@
    @* TAB 1 — Quality & Governance                                              *@
    @* ══════════════════════════════════════════════════════════════════════════ *@
    <div class="tab-pane fade show active" id="quality" role="tabpanel">

        @if (ev != null)
        {
            @* ── Headline KPI row ───────────────────────────────────────────── *@
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-2">
                    <div class="card text-center h-100">
                        <div class="card-body py-3">
                            <div class="fs-3 fw-bold text-@ReadinessColour(ev.MappingReadinessScore)">
                                @ev.MappingReadinessScore.ToString("F1")
                            </div>
                            <div class="small text-muted">Readiness Score</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center h-100">
                        <div class="card-body py-3">
                            <div class="fs-3 fw-bold text-@PctColour(ev.MappingCoveragePercent)">
                                @ev.MappingCoveragePercent.ToString("F1")%
                            </div>
                            <div class="small text-muted">Field Coverage</div>
                            <div class="text-muted" style="font-size:.7rem">@ev.MappedFields / @ev.TotalTargetFields fields</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center h-100">
                        <div class="card-body py-3">
                            <div class="fs-3 fw-bold text-@PctColour(ev.AiAcceptanceRatePercent)">
                                @ev.AiAcceptanceRatePercent.ToString("F1")%
                            </div>
                            <div class="small text-muted">AI Acceptance Rate</div>
                            <div class="text-muted" style="font-size:.7rem">@ev.AcceptedWithoutChange accepted</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center h-100">
                        <div class="card-body py-3">
                            <div class="fs-3 fw-bold @(ev.HumanOverrideRatePercent > 30 ? "text-warning" : "text-success")">
                                @ev.HumanOverrideRatePercent.ToString("F1")%
                            </div>
                            <div class="small text-muted">Human Override Rate</div>
                            <div class="text-muted" style="font-size:.7rem">@(ev.HumanModified + ev.HumanRejected) overrides</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center h-100">
                        <div class="card-body py-3">
                            <div class="fs-3 fw-bold text-@PctColour(ev.TransformationAccuracyPercent)">
                                @(ev.TransformationsReviewedCount > 0 ? ev.TransformationAccuracyPercent.ToString("F1") + "%" : "—")
                            </div>
                            <div class="small text-muted">Transform Accuracy</div>
                            <div class="text-muted" style="font-size:.7rem">@ev.TransformationsReviewedCount / @ev.TransformationsTotalCount reviewed</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card text-center h-100">
                        <div class="card-body py-3">
                            <div class="fs-3 fw-bold text-@PctColour(ev.ArtifactGenerationSuccessRatePercent)">
                                @ev.ArtifactGenerationSuccessRatePercent.ToString("F1")%
                            </div>
                            <div class="small text-muted">Artifact Success Rate</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">

                @* ── Confidence Calibration ──────────────────────────────────── *@
                <div class="col-md-5">
                    <div class="card h-100">
                        <div class="card-header bg-white fw-semibold">
                            <i class="fas fa-gauge me-2 text-info"></i>Confidence Calibration
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tier</th>
                                        <th class="text-center">AI Suggestions</th>
                                        <th class="text-center">Accepted</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><span class="badge bg-success">High &gt; 90%</span></td>
                                        <td class="text-center">@ev.ConfidenceCalibration.HighConfidenceCount</td>
                                        <td class="text-center">
                                            @if (ev.ConfidenceCalibration.HighConfidenceCount > 0)
                                            {
                                                <span class="fw-semibold text-success">@ev.ConfidenceCalibration.HighConfidenceAcceptanceRate.ToString("F1")%</span>
                                            }
                                            else { <span class="text-muted">—</span> }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><span class="badge bg-warning text-dark">Medium 70–90%</span></td>
                                        <td class="text-center">@ev.ConfidenceCalibration.MediumConfidenceCount</td>
                                        <td class="text-center">
                                            @if (ev.ConfidenceCalibration.MediumConfidenceCount > 0)
                                            {
                                                <span class="fw-semibold text-warning">@ev.ConfidenceCalibration.MediumConfidenceAcceptanceRate.ToString("F1")%</span>
                                            }
                                            else { <span class="text-muted">—</span> }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><span class="badge bg-danger">Low &lt; 70%</span></td>
                                        <td class="text-center">@ev.ConfidenceCalibration.LowConfidenceCount</td>
                                        <td class="text-center">
                                            @if (ev.ConfidenceCalibration.LowConfidenceCount > 0)
                                            {
                                                <span class="fw-semibold text-danger">@ev.ConfidenceCalibration.LowConfidenceAcceptanceRate.ToString("F1")%</span>
                                            }
                                            else { <span class="text-muted">—</span> }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @* ── Mapping Source Breakdown ─────────────────────────────────── *@
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-header bg-white fw-semibold">
                            <i class="fas fa-pie-chart me-2 text-primary"></i>Mapping Sources
                        </div>
                        <div class="card-body">
                            @if (ev.MappingSourceBreakdown.Any())
                            {
                                int totalSources = ev.MappingSourceBreakdown.Values.Sum();
                                foreach (var kv in ev.MappingSourceBreakdown.OrderByDescending(x => x.Value))
                                {
                                    double pct = totalSources > 0 ? kv.Value * 100.0 / totalSources : 0;
                                    string barColor = kv.Key.Contains("AI", StringComparison.OrdinalIgnoreCase) ? "info"
                                        : kv.Key.Contains("Manual", StringComparison.OrdinalIgnoreCase) ? "warning"
                                        : kv.Key.Contains("Historical", StringComparison.OrdinalIgnoreCase) ? "success"
                                        : "secondary";
                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between small mb-1">
                                            <span>@kv.Key</span>
                                            <span class="fw-semibold">@kv.Value <span class="text-muted fw-normal">(@pct.ToString("F0")%)</span></span>
                                        </div>
                                        <div class="progress" style="height:6px">
                                            <div class="progress-bar bg-@barColor" style="width:@pct.ToString("F0")%"></div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted small mb-0">No source breakdown available.</p>
                            }
                        </div>
                    </div>
                </div>

                @* ── Human Validation Summary ─────────────────────────────────── *@
                <div class="col-md-3">
                    <div class="card h-100">
                        <div class="card-header bg-white fw-semibold">
                            <i class="fas fa-user-check me-2 text-success"></i>Human Validation
                        </div>
                        <div class="card-body">
                            <ul class="list-unstyled mb-0">
                                <li class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="small text-muted">Total AI Suggestions</span>
                                    <strong>@ev.TotalAiSuggestions</strong>
                                </li>
                                <li class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="small text-muted">Accepted As-Is</span>
                                    <strong class="text-success">@ev.AcceptedWithoutChange</strong>
                                </li>
                                <li class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="small text-muted">Modified</span>
                                    <strong class="text-warning">@ev.HumanModified</strong>
                                </li>
                                <li class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="small text-muted">Rejected</span>
                                    <strong class="text-danger">@ev.HumanRejected</strong>
                                </li>
                                <li class="d-flex justify-content-between py-1">
                                    <span class="small text-muted">Unresolved Fields</span>
                                    <strong class="@(ev.UnresolvedFields > 0 ? "text-danger" : "text-success")">@ev.UnresolvedFields</strong>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                @* ── Gap Analysis ─────────────────────────────────────────────── *@
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-white fw-semibold">
                            <i class="fas fa-magnifying-glass me-2 text-danger"></i>Gap Analysis
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @* Unmapped fields *@
                                <div class="col-md-4">
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="badge bg-danger me-2">@ev.GapAnalysis.UnmappedTargetFields</span>
                                        <strong class="small">Unmapped Target Fields</strong>
                                    </div>
                                    @if (ev.GapAnalysis.UnmappedFieldNames.Any())
                                    {
                                        <div class="border rounded p-2" style="max-height:120px;overflow-y:auto;font-size:.78rem">
                                            @foreach (var f in ev.GapAnalysis.UnmappedFieldNames)
                                            {
                                                <div class="text-danger"><i class="fas fa-times-circle me-1"></i>@f</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-success small"><i class="fas fa-check-circle me-1"></i>All fields mapped</div>
                                    }
                                </div>

                                @* Manual review required *@
                                <div class="col-md-4">
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="badge bg-warning text-dark me-2">@ev.GapAnalysis.ManualReviewRequiredCount</span>
                                        <strong class="small">Manual Review Required</strong>
                                    </div>
                                    @if (ev.GapAnalysis.ManualReviewFieldNames.Any())
                                    {
                                        <div class="border rounded p-2" style="max-height:120px;overflow-y:auto;font-size:.78rem">
                                            @foreach (var f in ev.GapAnalysis.ManualReviewFieldNames)
                                            {
                                                <div class="text-warning"><i class="fas fa-exclamation-circle me-1"></i>@f</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-success small"><i class="fas fa-check-circle me-1"></i>None requiring manual review</div>
                                    }
                                </div>

                                @* Unreviewed transformations *@
                                <div class="col-md-4">
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="badge bg-secondary me-2">@ev.GapAnalysis.UnreviewedTransformationsCount</span>
                                        <strong class="small">Unreviewed Transformations</strong>
                                    </div>
                                    @if (ev.GapAnalysis.UnreviewedTransformationFields.Any())
                                    {
                                        <div class="border rounded p-2" style="max-height:120px;overflow-y:auto;font-size:.78rem">
                                            @foreach (var f in ev.GapAnalysis.UnreviewedTransformationFields)
                                            {
                                                <div class="text-muted"><i class="fas fa-clock me-1"></i>@f</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-success small"><i class="fas fa-check-circle me-1"></i>All transformations reviewed</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }

    </div>

    @* ══════════════════════════════════════════════════════════════════════════ *@
    @* TAB 2 — Cost & Usage                                                      *@
    @* ══════════════════════════════════════════════════════════════════════════ *@
    <div class="tab-pane fade" id="cost" role="tabpanel">

        @* ── Provider / Model info ───────────────────────────────────────────── *@
        @if (ev?.Processing != null)
        {
            <div class="alert alert-light border d-flex align-items-center gap-4 mb-4 py-2">
                <span class="small"><i class="fas fa-microchip me-1 text-info"></i><strong>Provider:</strong>
                    @(string.IsNullOrWhiteSpace(ev.Processing.LlmProviderUsed) ? "—" : ev.Processing.LlmProviderUsed)
                </span>
                <span class="small"><i class="fas fa-brain me-1 text-primary"></i><strong>Mapping Model:</strong>
                    @(string.IsNullOrWhiteSpace(ev.Processing.LlmModelUsed) ? "—" : ev.Processing.LlmModelUsed)
                </span>
                @if (ev.Processing.FallbackTriggered)
                {
                    <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle me-1"></i>Fallback triggered</span>
                }
            </div>
        }

        @* ── Token / Cost summary cards ──────────────────────────────────────── *@
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-2">
                <div class="card text-center h-100">
                    <div class="card-body py-3">
                        @{
                            long totalTok = ai.Sum(a => (long)(a.TotalTokens ?? 0));
                        }
                        <div class="fs-4 fw-bold text-info">@totalTok.ToString("N0")</div>
                        <div class="small text-muted">Total Tokens</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center h-100">
                    <div class="card-body py-3">
                        <div class="fs-4 fw-bold">@ai.Sum(a => (long)(a.PromptTokens ?? 0)).ToString("N0")</div>
                        <div class="small text-muted">Prompt Tokens</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center h-100">
                    <div class="card-body py-3">
                        <div class="fs-4 fw-bold">@ai.Sum(a => (long)(a.CompletionTokens ?? 0)).ToString("N0")</div>
                        <div class="small text-muted">Completion Tokens</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center h-100">
                    <div class="card-body py-3">
                        <div class="fs-4 fw-bold text-warning">
                            $@ai.Sum(a => a.EstimatedCostUsd ?? 0).ToString("F4")
                        </div>
                        <div class="small text-muted">Est. Cost (USD)</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center h-100">
                    <div class="card-body py-3">
                        <div class="fs-4 fw-bold">@ai.Count(a => a.WasCached)</div>
                        <div class="small text-muted">Cache Hits</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card text-center h-100">
                    <div class="card-body py-3">
                        @{
                            double totalMs = ev?.Processing.TotalWorkflowDurationMs ?? 0;
                            string durationLabel = totalMs >= 60000
                                ? $"{totalMs / 60000:F1} min"
                                : $"{totalMs / 1000:F1} s";
                        }
                        <div class="fs-4 fw-bold">@durationLabel</div>
                        <div class="small text-muted">Total Duration</div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Per-step timing table ────────────────────────────────────────────── *@
        @if (ev?.Processing.StepMetrics.Any() == true)
        {
            <div class="card mb-4">
                <div class="card-header bg-white fw-semibold">
                    <i class="fas fa-stopwatch me-2 text-info"></i>Step-by-Step Timing
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Step</th>
                                <th>Status</th>
                                <th class="text-end">Duration</th>
                                <th>Started</th>
                                <th>Completed</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in ev.Processing.StepMetrics)
                            {
                                string stepBadge = s.Status switch
                                {
                                    "Completed" => "success",
                                    "Failed"    => "danger",
                                    "Skipped"   => "secondary",
                                    "Running"   => "primary",
                                    _           => "light"
                                };
                                string dur = s.DurationMs >= 60000
                                    ? $"{s.DurationMs / 60000:F1} min"
                                    : $"{s.DurationMs / 1000:F1} s";
                                <tr>
                                    <td class="small">@s.Step</td>
                                    <td><span class="badge bg-@stepBadge">@s.Status</span></td>
                                    <td class="text-end small">@dur</td>
                                    <td class="small text-muted">@(s.StartedAt?.ToString("HH:mm:ss") ?? "—")</td>
                                    <td class="small text-muted">@(s.CompletedAt?.ToString("HH:mm:ss") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* ── Per-call AI audit detail ─────────────────────────────────────────── *@
        @if (ai.Any())
        {
            <div class="card">
                <div class="card-header bg-white fw-semibold">
                    <i class="fas fa-robot me-2 text-warning"></i>AI Inference Calls
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Step</th>
                                <th>Model</th>
                                <th class="text-center">Cached</th>
                                <th class="text-end">Prompt</th>
                                <th class="text-end">Completion</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Cost</th>
                                <th>Called At</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in ai.OrderBy(x => x.RequestedAt))
                            {
                                <tr>
                                    <td class="small">@a.Step</td>
                                    <td class="small text-muted">—</td>
                                    <td class="text-center">
                                        @if (a.WasCached)
                                        {
                                            <i class="fas fa-bolt text-success" title="Cache hit"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-cloud text-muted" title="API call"></i>
                                        }
                                    </td>
                                    <td class="text-end small">@(a.PromptTokens?.ToString("N0") ?? "—")</td>
                                    <td class="text-end small">@(a.CompletionTokens?.ToString("N0") ?? "—")</td>
                                    <td class="text-end small">@(a.TotalTokens?.ToString("N0") ?? "—")</td>
                                    <td class="text-end small">
                                        @(a.EstimatedCostUsd.HasValue ? "$" + a.EstimatedCostUsd.Value.ToString("F4") : "—")
                                    </td>
                                    <td class="small text-muted">@a.RequestedAt.ToString("HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3"><strong>Totals</strong></td>
                                <td class="text-end fw-semibold">@ai.Sum(a => (long)(a.PromptTokens ?? 0)).ToString("N0")</td>
                                <td class="text-end fw-semibold">@ai.Sum(a => (long)(a.CompletionTokens ?? 0)).ToString("N0")</td>
                                <td class="text-end fw-semibold">@ai.Sum(a => (long)(a.TotalTokens ?? 0)).ToString("N0")</td>
                                <td class="text-end fw-semibold">$@ai.Sum(a => a.EstimatedCostUsd ?? 0).ToString("F4")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">No AI inference calls recorded for this job.</div>
        }

    </div>

    @* ══════════════════════════════════════════════════════════════════════════ *@
    @* TAB 3 — Audit Trail                                                       *@
    @* ══════════════════════════════════════════════════════════════════════════ *@
    <div class="tab-pane fade" id="audittrail" role="tabpanel">

        @if (log?.Entries.Any() == true)
        {
            <div class="card">
                <div class="card-header bg-white fw-semibold d-flex align-items-center">
                    <i class="fas fa-list-check me-2 text-success"></i>Governance Audit Log
                    <span class="badge bg-secondary ms-2">@log.Entries.Count entries</span>
                    <span class="ms-auto small text-muted">Reviewer: @log.ReviewerName</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Time</th>
                                <th>Action</th>
                                <th>Step</th>
                                <th>Target Field</th>
                                <th>Source Field</th>
                                <th>AI Suggested</th>
                                <th>Human Choice</th>
                                <th class="text-end">AI Conf.</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in log.Entries.OrderBy(x => x.Timestamp))
                            {
                                string actionBadge = e.ActionType switch
                                {
                                    "MAPPING_ACCEPTED"          => "success",
                                    "MAPPING_MODIFIED"          => "warning",
                                    "MAPPING_REJECTED"          => "danger",
                                    "VALUE_MAPPING_ACCEPTED"    => "info",
                                    "VALUE_MAPPING_MODIFIED"    => "warning",
                                    "TRANSFORMATION_ACCEPTED"   => "success",
                                    "TRANSFORMATION_OVERRIDDEN" => "warning",
                                    "TRANSFORMATION_REJECTED"   => "danger",
                                    "WORKFLOW_STARTED"          => "secondary",
                                    "WORKFLOW_COMPLETED"        => "primary",
                                    _                           => "light"
                                };
                                <tr>
                                    <td class="small text-muted text-nowrap">@e.Timestamp.ToString("HH:mm:ss")</td>
                                    <td><span class="badge bg-@actionBadge" style="font-size:.7rem">@e.ActionType</span></td>
                                    <td class="small text-muted">@e.WorkflowStep</td>
                                    <td class="small">@e.TargetField</td>
                                    <td class="small text-muted">@(e.SourceField ?? "—")</td>
                                    <td class="small text-muted" style="max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@e.AiSuggested">@(e.AiSuggested ?? "—")</td>
                                    <td class="small" style="max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@e.HumanChoice">@(e.HumanChoice ?? "—")</td>
                                    <td class="text-end small">
                                        @(e.AiConfidence.HasValue ? e.AiConfidence.Value.ToString("F2") : "—")
                                    </td>
                                    <td class="small text-muted">@(e.Notes ?? "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>No audit entries yet. Human validation actions (mapping approvals, transformation overrides) are recorded here as they happen.
            </div>
        }

    </div>

    @* ══════════════════════════════════════════════════════════════════════════ *@
    @* TAB 4 — Run History & Comparison                                          *@
    @* ══════════════════════════════════════════════════════════════════════════ *@
    <div class="tab-pane fade" id="history" role="tabpanel">

        @if (!Model.RunHistory.Runs.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>No evaluation runs recorded yet. Each time Step 14 completes or you click "Recompute", a snapshot is saved here.
            </div>
        }
        else
        {
            @* Embed run data for JS comparison *@
            <script>
                const runHistory = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RunHistory.Runs,
                    new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
            </script>

            <div class="d-flex align-items-center mb-3 gap-2">
                <span class="small text-muted">Select two rows to compare</span>
                <button class="btn btn-sm btn-outline-primary ms-auto" id="btnCompare" disabled onclick="showComparison()">
                    <i class="fas fa-code-compare me-1"></i>Compare Selected
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="clearSelection()">Clear</button>
            </div>

            <div class="card mb-4">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0" id="historyTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width:36px"></th>
                                <th>#</th>
                                <th>Computed At</th>
                                <th>Reviewer</th>
                                <th>Provider / Model</th>
                                <th class="text-end">Readiness</th>
                                <th class="text-end">Coverage</th>
                                <th class="text-end">AI Accept.</th>
                                <th class="text-end">Override</th>
                                <th class="text-end">Transform.</th>
                                <th class="text-end">Unmapped</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int prevIdx = -1; }
                            @for (int i = Model.RunHistory.Runs.Count - 1; i >= 0; i--)
                            {
                                var run = Model.RunHistory.Runs[i];
                                var prev = i > 0 ? Model.RunHistory.Runs[i - 1] : null;

                                string Delta(double curr, double previous, bool lowerIsBetter = false)
                                {
                                    if (prev == null) return "";
                                    double diff = curr - previous;
                                    if (Math.Abs(diff) < 0.05) return "<span class='text-muted small'>—</span>";
                                    bool improved = lowerIsBetter ? diff < 0 : diff > 0;
                                    string cls = improved ? "text-success" : "text-danger";
                                    string arrow = diff > 0 ? "▲" : "▼";
                                    return $"<span class='{cls} small'>{arrow}{Math.Abs(diff):F1}</span>";
                                }

                                <tr class="history-row" data-run-idx="@i" onclick="toggleRow(this, @i)" style="cursor:pointer">
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input run-check" data-run-idx="@i" onclick="event.stopPropagation();toggleRow(this.closest('tr'), @i)" />
                                    </td>
                                    <td class="fw-semibold">@run.RunIndex</td>
                                    <td class="small text-nowrap">@run.ComputedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="small">@run.ReviewerName</td>
                                    <td class="small text-muted">
                                        @if (!string.IsNullOrWhiteSpace(run.LlmProvider))
                                        {
                                            <span>@run.LlmProvider</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(run.LlmModel))
                                        {
                                            <br /><span class="text-muted" style="font-size:.7rem">@run.LlmModel</span>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold @(run.MappingReadinessScore >= 80 ? "text-success" : run.MappingReadinessScore >= 50 ? "text-warning" : "text-danger")">
                                        @run.MappingReadinessScore.ToString("F1")
                                        @Html.Raw(Delta(run.MappingReadinessScore, prev?.MappingReadinessScore ?? 0))
                                    </td>
                                    <td class="text-end">@run.MappingCoveragePercent.ToString("F1")%
                                        @Html.Raw(Delta(run.MappingCoveragePercent, prev?.MappingCoveragePercent ?? 0))</td>
                                    <td class="text-end">@run.AiAcceptanceRatePercent.ToString("F1")%
                                        @Html.Raw(Delta(run.AiAcceptanceRatePercent, prev?.AiAcceptanceRatePercent ?? 0))</td>
                                    <td class="text-end">@run.HumanOverrideRatePercent.ToString("F1")%
                                        @Html.Raw(Delta(run.HumanOverrideRatePercent, prev?.HumanOverrideRatePercent ?? 0, lowerIsBetter: true))</td>
                                    <td class="text-end">
                                        @(run.TransformationAccuracyPercent > 0 ? run.TransformationAccuracyPercent.ToString("F1") + "%" : "—")
                                        @Html.Raw(Delta(run.TransformationAccuracyPercent, prev?.TransformationAccuracyPercent ?? 0))</td>
                                    <td class="text-end @(run.GapUnmappedCount > 0 ? "text-danger" : "text-success")">
                                        @run.GapUnmappedCount
                                        @Html.Raw(Delta(run.GapUnmappedCount, prev?.GapUnmappedCount ?? 0, lowerIsBetter: true))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* ── Comparison panel (hidden until two rows selected) ─────────────── *@
            <div id="comparePanel" class="card d-none">
                <div class="card-header bg-white fw-semibold">
                    <i class="fas fa-code-compare me-2 text-primary"></i>Run Comparison
                    <button type="button" class="btn-close float-end" onclick="clearSelection()"></button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0" id="compareTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Metric</th>
                                    <th class="text-center" id="cmpH1">Run A</th>
                                    <th class="text-center" id="cmpH2">Run B</th>
                                    <th class="text-center">Delta (B – A)</th>
                                </tr>
                            </thead>
                            <tbody id="compareBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

    </div>

</div>

@section Scripts {
<script>
    // ── Run History selection & comparison ─────────────────────────────────────
    let selected = [];

    function toggleRow(tr, idx) {
        const cb = tr.querySelector('.run-check');
        const alreadyIdx = selected.indexOf(idx);
        if (alreadyIdx >= 0) {
            selected.splice(alreadyIdx, 1);
            tr.classList.remove('table-active');
            if (cb) cb.checked = false;
        } else {
            if (selected.length >= 2) return;
            selected.push(idx);
            tr.classList.add('table-active');
            if (cb) cb.checked = true;
        }
        document.getElementById('btnCompare').disabled = selected.length !== 2;
        if (selected.length < 2) document.getElementById('comparePanel').classList.add('d-none');
    }

    function clearSelection() {
        selected = [];
        document.querySelectorAll('.history-row').forEach(r => r.classList.remove('table-active'));
        document.querySelectorAll('.run-check').forEach(cb => cb.checked = false);
        document.getElementById('btnCompare').disabled = true;
        document.getElementById('comparePanel').classList.add('d-none');
    }

    function showComparison() {
        if (selected.length !== 2) return;
        const [iA, iB] = selected.slice().sort((a, b) => a - b);
        const runA = runHistory[iA];
        const runB = runHistory[iB];

        document.getElementById('cmpH1').textContent = `Run ${runA.runIndex} (${runA.computedAt.substring(0,10)})`;
        document.getElementById('cmpH2').textContent = `Run ${runB.runIndex} (${runB.computedAt.substring(0,10)})`;

        const metrics = [
            { label: 'Readiness Score',         keyA: 'mappingReadinessScore',            fmt: v => v.toFixed(1),         lowerIsBetter: false },
            { label: 'Field Coverage %',         keyA: 'mappingCoveragePercent',           fmt: v => v.toFixed(1) + '%',   lowerIsBetter: false },
            { label: 'AI Acceptance Rate %',     keyA: 'aiAcceptanceRatePercent',          fmt: v => v.toFixed(1) + '%',   lowerIsBetter: false },
            { label: 'Human Override Rate %',    keyA: 'humanOverrideRatePercent',         fmt: v => v.toFixed(1) + '%',   lowerIsBetter: true  },
            { label: 'Transform Accuracy %',     keyA: 'transformationAccuracyPercent',    fmt: v => v > 0 ? v.toFixed(1) + '%' : '—', lowerIsBetter: false },
            { label: 'Artifact Success %',       keyA: 'artifactGenerationSuccessRatePercent', fmt: v => v.toFixed(1) + '%', lowerIsBetter: false },
            { label: 'Mapped Fields',            keyA: 'mappedFields',                     fmt: v => v,                    lowerIsBetter: false },
            { label: 'Unresolved Fields',        keyA: 'unresolvedFields',                 fmt: v => v,                    lowerIsBetter: true  },
            { label: 'Accepted Without Change',  keyA: 'acceptedWithoutChange',            fmt: v => v,                    lowerIsBetter: false },
            { label: 'Human Modified',           keyA: 'humanModified',                    fmt: v => v,                    lowerIsBetter: true  },
            { label: 'Human Rejected',           keyA: 'humanRejected',                    fmt: v => v,                    lowerIsBetter: true  },
            { label: 'Gap: Unmapped Fields',     keyA: 'gapUnmappedCount',                fmt: v => v,                    lowerIsBetter: true  },
            { label: 'Gap: Manual Review Req.',  keyA: 'gapManualReviewCount',             fmt: v => v,                    lowerIsBetter: true  },
            { label: 'Gap: Unreviewed Transforms', keyA: 'gapUnreviewedTransformCount',   fmt: v => v,                    lowerIsBetter: true  },
        ];

        const tbody = document.getElementById('compareBody');
        tbody.innerHTML = '';
        for (const m of metrics) {
            const vA = runA[m.keyA] ?? 0;
            const vB = runB[m.keyA] ?? 0;
            const diff = vB - vA;
            let deltaCls = 'text-muted';
            let deltaStr = '—';
            if (Math.abs(diff) >= 0.05) {
                const improved = m.lowerIsBetter ? diff < 0 : diff > 0;
                deltaCls = improved ? 'text-success fw-semibold' : 'text-danger fw-semibold';
                deltaStr = (diff > 0 ? '+' : '') + (typeof vA === 'number' && !Number.isInteger(vA) ? diff.toFixed(1) : diff);
            }
            tbody.insertAdjacentHTML('beforeend', `
                <tr>
                    <td class="small">${m.label}</td>
                    <td class="text-center small">${m.fmt(vA)}</td>
                    <td class="text-center small">${m.fmt(vB)}</td>
                    <td class="text-center ${deltaCls}">${deltaStr}</td>
                </tr>`);
        }

        document.getElementById('comparePanel').classList.remove('d-none');
        document.getElementById('comparePanel').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
</script>
}
