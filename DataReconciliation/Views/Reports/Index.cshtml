@model List<DataReconciliation.Domain.Entities.WorkflowJob>
@{
    ViewData["Title"] = "Reports";
}

<h2 class="mb-4"><i class="fas fa-chart-bar me-2 text-primary"></i>Reports</h2>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Job ID</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Reports</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model)
                    {
                        <tr>
                            <td><code class="small">@job.JobId</code></td>
                            <td>@job.JobName</td>
                            <td><span class="badge bg-secondary">@job.Status</span></td>
                            <td class="small">@job.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <a asp-action="Reconciliation" asp-route-jobId="@job.JobId"
                                   class="btn btn-sm btn-outline-info me-1">
                                    <i class="fas fa-balance-scale"></i> Reconciliation
                                </a>
                                <a asp-action="Mappings" asp-route-jobId="@job.JobId"
                                   class="btn btn-sm btn-outline-secondary me-1">
                                    <i class="fas fa-link"></i> Mappings
                                </a>
                                <a asp-action="AIAudit" asp-route-jobId="@job.JobId"
                                   class="btn btn-sm btn-outline-warning">
                                    <i class="fas fa-robot"></i> AI Audit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
