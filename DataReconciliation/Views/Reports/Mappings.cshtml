                    @if (valueMappingTemplates.Any() || hasUploadedValueMappingSeed)
                    {
                        <div class="d-flex align-items-center gap-2 mb-3 border-bottom pb-3 flex-wrap">
                            <span class="text-muted small text-nowrap">Load template:</span>
                            <select class="form-select form-select-sm" id="vmReviewTemplateSelect" style="max-width:280px">
                                <option value="">-- Select template --</option>
                                @foreach (var t in valueMappingTemplates)
                                {
                                    <option value="@t.TemplateName">@t.TemplateName</option>
