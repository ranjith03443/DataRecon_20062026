        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════
         MODAL 3 – Transformation Preview
    ═══════════════════════════════════════════════════════ -->
    <div class="modal fade" id="txPreviewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-eye me-2"></i>Transformation Preview</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="txPreviewContent">
                        <div class="text-center py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading preview…</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (() => {
        const JOB_ID = '@jobId';

        function escHtml(v) {
            return (v ?? '').toString()
                .replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')
                .replaceAll('"','&quot;').replaceAll("'",'&#39;');
        }

        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        }

        // ── Multi-source: Add Source button ────────────────
        const SOURCE_FIELD_OPTIONS = (() => {
            // Collect all source field option HTML from first primary select in the table
            const firstSel = document.querySelector('select[name^="Updates["][name$="].SourceField"]');
            if (!firstSel) return '<option value="">-- Select --</option>';
            return [...firstSel.options].map(o =>
                `<option value="${escHtml(o.value)}">${escHtml(o.text)}</option>`).join('');
        })();

        function reindexAdditionalSources(container, rowIdx) {
            container.querySelectorAll('.additional-source-row').forEach((row, ai) => {
                const ruleSel  = row.querySelector('.add-rule-sel');
                const fieldSel = row.querySelector('.add-field-sel');
                if (ruleSel)  ruleSel.name  = `Updates[${rowIdx}].AdditionalSources[${ai}].MergeRule`;
                if (fieldSel) fieldSel.name = `Updates[${rowIdx}].AdditionalSources[${ai}].SourceField`;
            });
        }

        document.addEventListener('click', (e) => {
            // Add Source
            const addBtn = e.target.closest('.add-source-btn');
            if (addBtn) {
                const rowIdx = addBtn.dataset.idx;
                const container = document.querySelector(`.additional-sources-container[data-idx="${rowIdx}"]`);
                if (!container) return;
                const ai = container.querySelectorAll('.additional-source-row').length;
                const div = document.createElement('div');
                div.className = 'additional-source-row d-flex align-items-center gap-1 mb-1';
                div.innerHTML = `
                    <select name="Updates[${rowIdx}].AdditionalSources[${ai}].MergeRule"
                            class="form-select form-select-sm add-rule-sel" style="width:90px;min-width:90px">
                        <option value="FALLBACK">FALLBACK</option>
                        <option value="CONCAT">CONCAT</option>
                    </select>
                    <select name="Updates[${rowIdx}].AdditionalSources[${ai}].SourceField"
                            class="form-select form-select-sm add-field-sel">
                        ${SOURCE_FIELD_OPTIONS}
                    </select>
                    <button type="button" class="btn btn-sm btn-outline-danger remove-add-src" title="Remove">
                        <i class="fas fa-times"></i>
                    </button>`;
                container.appendChild(div);
                return;
            }

            // Remove additional source row
            const rmBtn = e.target.closest('.remove-add-src');
            if (rmBtn) {
                const row = rmBtn.closest('.additional-source-row');
                const container = row?.closest('.additional-sources-container');
                row?.remove();
                if (container) {
                    const rowIdx = container.dataset.idx;
                    reindexAdditionalSources(container, rowIdx);
                }
            }
        });

        // Re-index all additional sources before form submit so names are sequential
        document.getElementById('mappingsForm')?.addEventListener('submit', (event) => {
            document.querySelectorAll('.additional-sources-container').forEach(container => {
                reindexAdditionalSources(container, container.dataset.idx);
            });

            const cnt = document.querySelectorAll('.mapping-delete-checkbox:checked').length;
            if (cnt > 0 && !window.confirm(`Delete ${cnt} mapping(s)? This will also remove saved value-mapping rules for those target fields.`))
                event.preventDefault();
        }, true); // capture phase so reindex runs before the existing submit handler below

        // ── Delete row visual state ─────────────────────────
        function updateDeleteRowState(checkbox) {
            const row = checkbox.closest('tr');
            if (!row) return;
            const marked = checkbox.checked;
            row.classList.toggle('table-danger', marked);
            row.style.opacity = marked ? '0.7' : '1';
            const sel = row.querySelector('select[name$=".SourceField"]');
            if (sel) sel.disabled = marked;
            const vmBtn = row.querySelector('.value-mapping-btn');
            if (vmBtn) { vmBtn.disabled = marked; vmBtn.classList.toggle('disabled', marked); }
        }

        document.querySelectorAll('.mapping-delete-checkbox').forEach(cb => {
            updateDeleteRowState(cb);
            cb.addEventListener('change', () => updateDeleteRowState(cb));
        });

        document.getElementById('mappingsForm')?.addEventListener('submit', (event) => {
            const cnt = document.querySelectorAll('.mapping-delete-checkbox:checked').length;
            if (cnt > 0 && !window.confirm(`Delete ${cnt} mapping(s)? This will also remove saved value-mapping rules for those target fields.`))
                event.preventDefault();
        });

        // ── Value Mapping Editor (Modal 1) ──────────────────
        const vmEditorEl = document.getElementById('valueMappingModal');
        const vmEditorModal = (vmEditorEl && typeof bootstrap !== 'undefined') ? new bootstrap.Modal(vmEditorEl) : null;

        if (vmEditorModal) {
            const tbody     = document.getElementById('valueMappingTbody');
            const subtitle  = document.getElementById('valueMappingSubtitle');
            const tfInput   = document.getElementById('valueMappingTargetField');
            const sfInput   = document.getElementById('valueMappingSourceField');
            const tnInput   = document.getElementById('valueMappingTemplateName');
            const modalSel  = document.getElementById('modalTemplateSelect');
            const pageSel   = document.getElementById('templateSelect');
            const countLbl  = document.getElementById('valueMappingCountLabel');
            const excelInput = document.getElementById('valueMappingExcelFile');
            const excelImportBtn = document.getElementById('importExcelMappingBtn');
            const uploadedExcelImportBtn = document.getElementById('importUploadedExcelMappingBtn');
            const excelImportStatus = document.getElementById('excelImportStatus');

            const esc = (v) => (v ?? '').toString()
                .replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')
                .replaceAll('"','&quot;').replaceAll("'",'&#39;');

            const buildRow = (entry = {}) => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td><input type="text" class="form-control form-control-sm entry-source" value="${esc(entry.sourceValue)}" /></td>
                    <td><input type="text" class="form-control form-control-sm entry-target" value="${esc(entry.targetValue)}" /></td>
                    <td class="text-center"><input type="checkbox" class="form-check-input entry-enabled" ${entry.isEnabled === false ? '' : 'checked'} /></td>
                    <td><input type="text" class="form-control form-control-sm entry-notes" value="${esc(entry.notes)}" /></td>
                    <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger remove-row-btn"><i class="fas fa-trash"></i></button></td>`;
                row.querySelector('.remove-row-btn').addEventListener('click', () => { row.remove(); updateCount(); });
                return row;
            };

            const updateCount = () => {
                const active = [...tbody.querySelectorAll('tr')].filter(r => r.querySelector('.entry-enabled')?.checked).length;
                countLbl.textContent = `${active} active rules`;
            };

            const loadRows = (rulesMap) => {
                tbody.innerHTML = '';
                const entries = Object.entries(rulesMap ?? {});
                if (!entries.length) tbody.appendChild(buildRow());
                else entries.forEach(([sv, tv]) => tbody.appendChild(buildRow({ sourceValue: sv, targetValue: tv, isEnabled: true })));
                updateCount();
            };

            const parseRules = (raw) => { try { return JSON.parse(raw || '{}'); } catch { return {}; } };

            const openMappingButton = (button) => {
                const tf = button.dataset.targetField || '';
                const sf = button.dataset.sourceField || '';
                tfInput.value = tf; sfInput.value = sf;
                tnInput.value = button.dataset.templateName || tf;
                subtitle.textContent = `${tf}${sf ? ` · Source: ${sf}` : ''}`;
                loadRows(parseRules(button.dataset.rules));
                vmEditorModal.show();
            };

            document.addEventListener('click', (e) => {
                const btn = e.target.closest('.value-mapping-btn');
                if (btn) openMappingButton(btn);
            });

            document.getElementById('addValueMappingRowBtn')?.addEventListener('click', () => { tbody.appendChild(buildRow()); updateCount(); });

            document.getElementById('loadModalTemplateBtn')?.addEventListener('click', async () => {
                const tn = modalSel.value;
                if (!tn) return;
                // Special case: uploaded seed file — delegate to Import Uploaded Excel
                if (tn === '__uploaded_seed__') {
                    uploadedExcelImportBtn?.click();
                    return;
                }
                const res = await fetch(`@Url.Action("LoadValueMappingTemplate","Reports")?jobId=${JOB_ID}&templateName=${encodeURIComponent(tn)}`);
                if (!res.ok) { if (excelImportStatus) excelImportStatus.textContent = 'Template could not be loaded.'; return; }
                const payload = await res.json();
                const af = tfInput.value;
                const tf = payload.fields?.find(f => f.targetField?.toLowerCase() === af.toLowerCase()) ?? payload.fields?.[0];
                if (!tf) return;
                tnInput.value = tn;
                sfInput.value = tf.sourceField ?? sfInput.value;
                const rules = {};
                (tf.entries ?? []).forEach(e => { if (e.isEnabled !== false && e.sourceValue) rules[e.sourceValue] = e.targetValue ?? ''; });
                loadRows(rules);
            });

            document.getElementById('loadTemplateBtn')?.addEventListener('click', () => {
                const tn = pageSel.value;
                if (!tn) return;
                // Special case: uploaded seed file — prompt user to open a value mapping row first
                if (tn === '__uploaded_seed__') {
                    if (excelImportStatus) excelImportStatus.textContent = 'Open a value mapping row, then select the seed from the modal template dropdown and click "Load Selected Template".';
                    return;
                }
                const btn = [...document.querySelectorAll('.value-mapping-btn')]
                    .find(b => (b.dataset.templateName || '').toLowerCase() === tn.toLowerCase());
                if (btn) { openMappingButton(btn); if (modalSel) modalSel.value = tn; }
                else { if (modalSel) modalSel.value = tn; if (excelImportStatus) excelImportStatus.textContent = 'Template selected. Open a row and click Load Selected Template to apply it.'; }
            });

            excelImportBtn?.addEventListener('click', async () => {
                const file = excelInput?.files?.[0];
                const activeTargetField = tfInput.value?.trim();

                if (!activeTargetField) {
                    alert('Open a mapping row first so target field context is available.');
                    return;
                }

                if (!file) {
                    alert('Select an Excel file to import.');
                    return;
                }

                excelImportBtn.disabled = true;
                if (excelImportStatus) excelImportStatus.textContent = 'Importing Excel rules…';

                try {
                    const formData = new FormData();
                    formData.append('jobId', JOB_ID);
                    formData.append('targetField', activeTargetField);
                    formData.append('sourceField', sfInput.value ?? '');
                    formData.append('excelFile', file);

                    const res = await fetch('@Url.Action("ImportValueMappingsFromExcel", "Reports")', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': getCsrfToken() },
                        body: formData
                    });

                    const payload = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        const available = (payload.availableCodeDescriptions ?? []).slice(0, 10).join(', ');
                        const suffix = available ? `\nAvailable: ${available}` : '';
                        throw new Error((payload.error ?? `HTTP ${res.status}`) + suffix);
                    }

                    const rules = {};
                    (payload.entries ?? []).forEach(entry => {
                        if (entry.sourceValue) rules[entry.sourceValue] = entry.targetValue ?? '';
                    });

                    loadRows(rules);
                    if (payload.sourceField && !sfInput.value) sfInput.value = payload.sourceField;
                    if (excelImportStatus) excelImportStatus.textContent = `Imported ${payload.importedCount ?? Object.keys(rules).length} rule(s) from Excel.`;
                } catch (err) {
                    if (excelImportStatus) excelImportStatus.textContent = `Import failed: ${err.message}`;
                    alert(`Excel import failed. ${err.message}`);
                } finally {
                    excelImportBtn.disabled = false;
                }
            });

            uploadedExcelImportBtn?.addEventListener('click', async () => {
                const activeTargetField = tfInput.value?.trim();

                if (!activeTargetField) {
                    alert('Open a mapping row first so target field context is available.');
                    return;
                }

                uploadedExcelImportBtn.disabled = true;
                if (excelImportStatus) excelImportStatus.textContent = 'Importing from uploaded Excel seed…';

                try {
                    const formData = new FormData();
                    formData.append('jobId', JOB_ID);
                    formData.append('targetField', activeTargetField);
                    formData.append('sourceField', sfInput.value ?? '');

                    const res = await fetch('@Url.Action("ImportValueMappingsFromUploadedExcel", "Reports")', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': getCsrfToken() },
                        body: formData
                    });

                    const payload = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        const available = (payload.availableCodeDescriptions ?? []).slice(0, 10).join(', ');
                        const suffix = available ? `\nAvailable: ${available}` : '';
                        throw new Error((payload.error ?? `HTTP ${res.status}`) + suffix);
                    }

                    const rules = {};
                    (payload.entries ?? []).forEach(entry => {
                        if (entry.sourceValue) rules[entry.sourceValue] = entry.targetValue ?? '';
                    });

                    loadRows(rules);
                    if (payload.sourceField && !sfInput.value) sfInput.value = payload.sourceField;
                    if (excelImportStatus) excelImportStatus.textContent = `Imported ${payload.importedCount ?? Object.keys(rules).length} rule(s) from uploaded Excel.`;
                } catch (err) {
                    if (excelImportStatus) excelImportStatus.textContent = `Import failed: ${err.message}`;
                    alert(`Excel import failed. ${err.message}`);
                } finally {
                    uploadedExcelImportBtn.disabled = false;
                }
            });

            document.getElementById('valueMappingForm')?.addEventListener('submit', () => {
                [...tbody.querySelectorAll('tr')].forEach((row, i) => {
                    row.querySelector('.entry-source').name  = `Entries[${i}].SourceValue`;
                    row.querySelector('.entry-target').name  = `Entries[${i}].TargetValue`;
                    row.querySelector('.entry-notes').name   = `Entries[${i}].Notes`;

                    // Fix checkbox binding: unchecked checkboxes don't submit, so use a hidden input
                    const checkbox = row.querySelector('.entry-enabled');
                    checkbox.removeAttribute('name'); // Don't submit the checkbox directly
                    let hiddenEnabled = row.querySelector('.entry-enabled-hidden');
                    if (!hiddenEnabled) {
                        hiddenEnabled = document.createElement('input');
                        hiddenEnabled.type = 'hidden';
                        hiddenEnabled.className = 'entry-enabled-hidden';
                        checkbox.parentElement.appendChild(hiddenEnabled);
                    }
                    hiddenEnabled.name = `Entries[${i}].IsEnabled`;
                    hiddenEnabled.value = checkbox.checked ? 'true' : 'false';
                });
                updateCount();
            });
        }

        // ── Re-AI Match ─────────────────────────────────────
        document.addEventListener('click', async (e) => {
            const btn = e.target.closest('.re-ai-btn');
            if (!btn) return;
            const tf = btn.dataset.targetField;
            btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            try {
                const res = await fetch('@Url.Action("ReAiMatch","Reports")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': getCsrfToken() },
                    body: `jobId=${encodeURIComponent(JOB_ID)}&targetField=${encodeURIComponent(tf)}`
                });
                btn.innerHTML = res.ok ? '<i class="fas fa-check text-success"></i>' : '<i class="fas fa-times text-danger"></i>';
            } catch { btn.innerHTML = '<i class="fas fa-times text-danger"></i>'; }
            setTimeout(() => { btn.disabled = false; btn.innerHTML = '<i class="fas fa-robot"></i>'; }, 2500);
        });

        // ── Value Mapping Tab (Tab 2) ───────────────────────
        let vmLoaded = false;
        let vmCandidates = [];
        let vmReviewCurrent = null;

        const vmReviewEl = document.getElementById('vmReviewModal');
        const vmReviewModal = (vmReviewEl && typeof bootstrap !== 'undefined') ? new bootstrap.Modal(vmReviewEl) : null;

        function statusBadge(status) {
            const map = { 'Complete': 'bg-success', 'Partial': 'bg-warning text-dark', 'Pending': 'bg-secondary', 'AI Suggested': 'bg-info' };
            return `<span class="badge ${map[status] ?? 'bg-secondary'}">${escHtml(status ?? 'Pending')}</span>`;
        }

        function updateVmKpis(candidates) {
            document.getElementById('vmKpiTotal').textContent    = candidates.length;
            document.getElementById('vmKpiComplete').textContent = candidates.filter(c => c.status === 'Complete').length;
            document.getElementById('vmKpiPartial').textContent  = candidates.filter(c => c.status === 'Partial').length;
            document.getElementById('vmKpiPending').textContent  = candidates.filter(c => !c.status || c.status === 'Pending').length;
            document.getElementById('vmCandidateBadge').textContent = candidates.length;
        }

        function renderVmCandidates(candidates, tbody) {
            tbody.innerHTML = '';
            candidates.forEach((c, i) => {
                const coverage = c.distinctValueCount > 0
                    ? Math.round(((c.suggestedMappings?.length ?? 0) / c.distinctValueCount) * 100) : 0;
                const badges = (c.distinctSourceValues ?? []).slice(0, 8)
                    .map(v => `<span class="badge bg-light text-dark border me-1 mb-1">${escHtml(v)}</span>`).join('') +
                    (c.distinctValueCount > 8 ? `<span class="text-muted small">+${c.distinctValueCount - 8} more</span>` : '');
                const reason = c.candidateReason || 'Low Cardinality';
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><code class="small">${escHtml(c.sourceField)}</code></td>
                    <td><code class="small">${escHtml(c.targetField)}</code></td>
                    <td><span class="badge bg-secondary me-1">${c.distinctValueCount}</span>${badges}</td>
                    <td>${c.suggestedMappings?.length ?? 0}</td>
                    <td>
                        <div class="progress" style="height:18px;min-width:80px">
                            <div class="progress-bar ${coverage >= 100 ? 'bg-success' : coverage > 0 ? 'bg-warning' : 'bg-danger'}"
                                 style="width:${coverage}%">${coverage}%</div>
                        </div>
                    </td>
                    <td>${statusBadge(c.status)}</td>
                    <td><span class="badge bg-light text-dark border">${escHtml(reason)}</span></td>
                    <td><button type="button" class="btn btn-sm btn-outline-primary vm-review-btn" data-index="${i}">
                        <i class="fas fa-edit me-1"></i>Review</button></td>`;
                tbody.appendChild(tr);
            });
        }

        async function loadVmCandidates() {
            const tbody = document.getElementById('vmCandidatesTbody');
            tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading…</td></tr>';
            try {
                const res = await fetch(`@Url.Action("GetValueMappingCandidates","Reports")?jobId=${JOB_ID}`);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                vmCandidates = data.candidates ?? [];
                updateVmKpis(vmCandidates);
                if (!vmCandidates.length)
                    tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No candidates found. Click <strong>Discover Candidates</strong>.</td></tr>';
                else
                    renderVmCandidates(vmCandidates, tbody);
                vmLoaded = true;
            } catch (e) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center text-danger py-3"><i class="fas fa-exclamation-triangle me-2"></i>${escHtml(e.message)}</td></tr>`;
                document.getElementById('vmCandidateBadge').textContent = '!';
            }
        }

        document.getElementById('tab-valuemapping')?.addEventListener('shown.bs.tab', () => { if (!vmLoaded) loadVmCandidates(); });
        document.getElementById('refreshVmBtn')?.addEventListener('click', () => { vmLoaded = false; loadVmCandidates(); });

        // Review modal
        document.addEventListener('click', (e) => {
            const btn = e.target.closest('.vm-review-btn');
            if (!btn || !vmReviewModal) return;
            vmReviewCurrent = vmCandidates[parseInt(btn.dataset.index, 10)];
            if (!vmReviewCurrent) return;
            document.getElementById('vmReviewSubtitle').textContent = `${vmReviewCurrent.sourceField} → ${vmReviewCurrent.targetField}`;
            const distinctVals = vmReviewCurrent.distinctSourceValues ?? [];
            const badges = distinctVals.map(v => `<span class="badge bg-light text-dark border me-1">${escHtml(v)}</span>`).join('');
            document.getElementById('vmReviewDistinctBadges').innerHTML =
                `<strong>${vmReviewCurrent.distinctValueCount} distinct source values:</strong> ${badges || '<em class="text-muted">none captured</em>'}`;

            // Reset template status
            const tmplStatus = document.getElementById('vmReviewTemplateStatus');
            if (tmplStatus) tmplStatus.textContent = '';

            // Populate rows: merge suggested mappings with uncovered distinct values
            const rvTbody = document.getElementById('vmReviewTbody');
            rvTbody.innerHTML = '';
            const suggested = vmReviewCurrent.suggestedMappings ?? [];
            if (suggested.length > 0) {
                suggested.forEach(m => rvTbody.appendChild(buildReviewRow(m)));
                const covered = new Set(suggested.map(m => (m.sourceValue ?? '').toLowerCase()));
                distinctVals.forEach(v => {
                    if (!covered.has(v.toLowerCase()))
                        rvTbody.appendChild(buildReviewRow({ sourceValue: v }));
                });
            } else if (distinctVals.length > 0) {
                // No AI suggestions — pre-fill left column with all distinct source values
                distinctVals.forEach(v => rvTbody.appendChild(buildReviewRow({ sourceValue: v })));
            } else {
                rvTbody.appendChild(buildReviewRow());
            }
            vmReviewModal.show();
        });

        // Review modal — template loader
        document.getElementById('vmReviewLoadTemplateBtn')?.addEventListener('click', async () => {
            const tn = document.getElementById('vmReviewTemplateSelect')?.value;
            const tmplStatus = document.getElementById('vmReviewTemplateStatus');
            if (!tn) { if (tmplStatus) tmplStatus.textContent = 'Select a template first.'; return; }
            if (!vmReviewCurrent) return;
            // Special case: uploaded seed file — import directly from the uploaded Excel
            if (tn === '__uploaded_seed__') {
                if (tmplStatus) tmplStatus.textContent = 'Loading from uploaded seed…';
                try {
                    const fd = new FormData();
                    fd.append('jobId', JOB_ID);
                    fd.append('targetField', vmReviewCurrent.targetField ?? '');
                    const seedRes = await fetch('@Url.Action("ImportValueMappingsFromUploadedExcel","Reports")', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': getCsrfToken() },
                        body: fd
                    });
                    if (!seedRes.ok) { if (tmplStatus) tmplStatus.textContent = 'Seed file could not be read.'; return; }
                    const seedPayload = await seedRes.json();
                    const rvTbody = document.getElementById('vmReviewTbody');
                    rvTbody.innerHTML = '';
                    const entries = seedPayload.entries ?? [];
                    const distinctVals = vmReviewCurrent.distinctSourceValues ?? [];
                    if (entries.length > 0) {
                        entries.forEach(e => rvTbody.appendChild(buildReviewRow({ sourceValue: e.sourceValue, targetValue: e.targetValue ?? '', confidence: 1.0 })));
                        const covered = new Set(entries.map(e => (e.sourceValue ?? '').toLowerCase()));
                        distinctVals.forEach(v => { if (!covered.has(v.toLowerCase())) rvTbody.appendChild(buildReviewRow({ sourceValue: v })); });
                        if (tmplStatus) tmplStatus.textContent = `Loaded ${entries.length} rule(s) from seed file.`;
                    } else {
                        distinctVals.forEach(v => rvTbody.appendChild(buildReviewRow({ sourceValue: v })));
                        if (tmplStatus) tmplStatus.textContent = 'No rules for this field in seed file — showing distinct values.';
                    }
                } catch (err) { if (tmplStatus) tmplStatus.textContent = `Error: ${err.message}`; }
                return;
            }
            if (tmplStatus) tmplStatus.textContent = 'Loading…';
            try {
                const res = await fetch(`@Url.Action("LoadValueMappingTemplate","Reports")?jobId=${JOB_ID}&templateName=${encodeURIComponent(tn)}`);
                if (!res.ok) { if (tmplStatus) tmplStatus.textContent = 'Could not load template.'; return; }
                const payload = await res.json();
                const tf = vmReviewCurrent.targetField;
                const templateField = payload.fields?.find(f => f.targetField?.toLowerCase() === tf?.toLowerCase()) ?? payload.fields?.[0];
                const rvTbody = document.getElementById('vmReviewTbody');
                rvTbody.innerHTML = '';
                const entries = (templateField?.entries ?? []).filter(e => e.isEnabled !== false && e.sourceValue);
                const distinctVals = vmReviewCurrent.distinctSourceValues ?? [];
                if (entries.length > 0) {
                    entries.forEach(e => rvTbody.appendChild(buildReviewRow({ sourceValue: e.sourceValue, targetValue: e.targetValue ?? '', confidence: 1.0 })));
                    const covered = new Set(entries.map(e => (e.sourceValue ?? '').toLowerCase()));
                    distinctVals.forEach(v => {
                        if (!covered.has(v.toLowerCase()))
                            rvTbody.appendChild(buildReviewRow({ sourceValue: v }));
                    });
                    if (tmplStatus) tmplStatus.textContent = `Loaded ${entries.length} rule(s) from "${tn}".`;
                } else {
                    distinctVals.forEach(v => rvTbody.appendChild(buildReviewRow({ sourceValue: v })));
                    if (tmplStatus) tmplStatus.textContent = `No rules for this field in "${tn}" — showing distinct values.`;
                }
            } catch (err) {
                if (tmplStatus) tmplStatus.textContent = `Error: ${err.message}`;
            }
        });

        function buildReviewRow(m = {}) {
            const row = document.createElement('tr');
            row.innerHTML = `
                <td><input type="text" class="form-control form-control-sm rv-source" value="${escHtml(m.sourceValue ?? '')}" /></td>
                <td><input type="text" class="form-control form-control-sm rv-target" value="${escHtml(m.targetValue ?? '')}" /></td>
                <td class="small text-muted">${m.confidence != null ? Number(m.confidence).toFixed(2) : '—'}</td>
                <td class="text-center">${m.isAiSuggested ? '<i class="fas fa-robot text-warning" title="AI suggested"></i>' : ''}</td>
                <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger rv-rm"><i class="fas fa-trash"></i></button></td>`;
            row.querySelector('.rv-rm').addEventListener('click', () => row.remove());
            return row;
        }

        document.getElementById('vmReviewAddRowBtn')?.addEventListener('click', () => {
            document.getElementById('vmReviewTbody').appendChild(buildReviewRow());
        });

        document.getElementById('vmReviewSaveBtn')?.addEventListener('click', async () => {
            if (!vmReviewCurrent) return;
            const rows = [...document.getElementById('vmReviewTbody').querySelectorAll('tr')];
            const mappings = rows.map(r => ({
                sourceValue: r.querySelector('.rv-source')?.value ?? '',
                targetValue: r.querySelector('.rv-target')?.value ?? '',
                confidence: 1.0,
                isAiSuggested: false
            })).filter(r => r.sourceValue);
            const saveBtn = document.getElementById('vmReviewSaveBtn');
            saveBtn.disabled = true;
            try {
                const res = await fetch(`@Url.Action("SaveCandidateMappings","Reports")?jobId=${encodeURIComponent(JOB_ID)}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                    body: JSON.stringify({ sourceField: vmReviewCurrent.sourceField, targetField: vmReviewCurrent.targetField, mappings })
                });
                if (res.ok) { vmReviewModal?.hide(); vmLoaded = false; loadVmCandidates(); }
                else {
                    const err = await res.json().catch(() => ({}));
                    alert(`Save failed: ${err.error || res.statusText || 'Unknown error'}`);
                }
            } catch (e) { alert(`Save failed: ${e.message}`); }
            finally { saveBtn.disabled = false; }
        });

        document.getElementById('genVmTemplateBtn')?.addEventListener('click', async () => {
            const btn = document.getElementById('genVmTemplateBtn');
            const status = document.getElementById('vmAiStatus');
            btn.disabled = true; status.textContent = 'Generating AI suggestions…';
            try {
                const res = await fetch('@Url.Action("GenerateValueMappingTemplate","Reports")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': getCsrfToken() },
                    body: `jobId=${encodeURIComponent(JOB_ID)}`
                });
                status.textContent = res.ok ? 'Done! Refreshing…' : 'AI generation failed.';
                if (res.ok) { vmLoaded = false; loadVmCandidates(); }
            } catch (e) { status.textContent = `Error: ${e.message}`; }
            finally { btn.disabled = false; }
        });

        // ── Transformation Preview (Modal 3) ────────────────
        const txPreviewEl = document.getElementById('txPreviewModal');
        const txPreviewModal = (txPreviewEl && typeof bootstrap !== 'undefined') ? new bootstrap.Modal(txPreviewEl) : null;

        document.querySelectorAll('.preview-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const count = btn.dataset.count;
                document.getElementById('previewStatus').textContent = 'Loading…';
                document.getElementById('txPreviewContent').innerHTML =
                    '<div class="text-center py-4"><i class="fas fa-spinner fa-spin me-2"></i>Loading preview…</div>';
                txPreviewModal?.show();
                try {
                    const res = await fetch(`@Url.Action("PreviewTransformations","Reports")?jobId=${JOB_ID}&count=${count}`);
                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                    const rows = await res.json();
                    document.getElementById('previewStatus').textContent = `Showing ${rows.length} row(s)`;
                    renderTxPreview(rows);
                } catch (e) {
                    document.getElementById('previewStatus').textContent = `Error: ${e.message}`;
                    document.getElementById('txPreviewContent').innerHTML = `<div class="alert alert-danger">${escHtml(e.message)}</div>`;
                }
            });
        });

        function renderTxPreview(rows) {
            if (!rows.length) {
                document.getElementById('txPreviewContent').innerHTML = '<div class="alert alert-info">No preview data available.</div>';
                return;
            }
            const fields = Object.keys(rows[0]?.before ?? {});
            let html = `<div class="table-responsive"><table class="table table-sm table-bordered align-middle" style="font-size:.8rem">
                <thead class="table-light"><tr><th>#</th>`;
            fields.forEach(f => html += `<th>${escHtml(f)}<br><span class="text-muted" style="font-size:.7rem">before → after</span></th>`);
            html += '</tr></thead><tbody>';
            rows.forEach((row, i) => {
                html += `<tr><td class="text-muted">${i+1}</td>`;
                fields.forEach(f => {
                    const bv = String(row.before?.[f] ?? '');
                    const av = String(row.after?.[f] ?? '');
                    const changed = bv !== av;
                    html += `<td${changed ? ' class="table-warning"' : ''}>
                        <div class="text-muted">${escHtml(bv)}</div>
                        ${changed ? `<div class="text-success fw-semibold">→ ${escHtml(av)}</div>` : ''}
                    </td>`;
                });
                html += '</tr>';
            });
            html += '</tbody></table></div>';
            document.getElementById('txPreviewContent').innerHTML = html;
        }

        // ── Eager load candidate count on page load ─────────
        fetch(`@Url.Action("GetValueMappingCandidates","Reports")?jobId=${JOB_ID}`)
            .then(r => r.ok ? r.json() : null)
            .then(data => {
                if (!data) { document.getElementById('vmCandidateBadge').textContent = '0'; return; }
                vmCandidates = data.candidates ?? [];
                updateVmKpis(vmCandidates);
                const tbody = document.getElementById('vmCandidatesTbody');
                if (vmCandidates.length) renderVmCandidates(vmCandidates, tbody);
                else tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No candidates found. Click <strong>Discover Candidates</strong>.</td></tr>';
                vmLoaded = true;
            })
            .catch(() => { document.getElementById('vmCandidateBadge').textContent = '?'; });

        // ═══════════════════════════════════════════════════════════════
        // Import Structural Mapping (upload panel — JS fetch replaces nested form)
        // ═══════════════════════════════════════════════════════════════
        document.getElementById('importMappingSubmitBtn')?.addEventListener('click', async () => {
            const fileInput = document.getElementById('importMappingFileInput');
            const statusEl  = document.getElementById('importMappingStatus');
            const file = fileInput?.files?.[0];
            if (!file) { statusEl.innerHTML = '<span class="text-warning">Select an Excel file first.</span>'; return; }
            statusEl.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Importing…';
            const fd = new FormData();
            fd.append('JobId', JOB_ID);
            fd.append('MappingFile', file);
            try {
                const res = await fetch('@Url.Action("ImportStructuralMapping","Reports")', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': getCsrfToken() },
                    body: fd
                });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                statusEl.innerHTML = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Imported. Reloading…</span>';
                setTimeout(() => window.location.reload(), 1200);
            } catch (err) {
                statusEl.innerHTML = `<span class="text-danger"><i class="fas fa-times-circle me-1"></i>Import failed: ${escHtml(err.message)}</span>`;
            }
        });

        // ═══════════════════════════════════════════════════════════════
        // ENHANCEMENT 1 — Delta File Upload
        // ═══════════════════════════════════════════════════════════════

        const deltaSourceInput = document.getElementById('deltaSourceFileInput');
        const deltaTargetInput = document.getElementById('deltaTargetFileInput');
        const deltaStatus = document.getElementById('deltaUploadStatus');

        document.getElementById('deltaUploadSourceBtn')?.addEventListener('click', () => deltaSourceInput?.click());
        document.getElementById('deltaUploadTargetBtn')?.addEventListener('click', () => deltaTargetInput?.click());
        document.querySelector('.delta-upload-src-vm')?.addEventListener('click', () => deltaSourceInput?.click());
        document.querySelector('.delta-upload-tgt-vm')?.addEventListener('click', () => deltaTargetInput?.click());

        deltaSourceInput?.addEventListener('change', async (e) => {
            const file = e.target.files?.[0];
            if (!file) return;
            await performDeltaUpload(file, 'source');
            e.target.value = '';
        });

        deltaTargetInput?.addEventListener('change', async (e) => {
            const file = e.target.files?.[0];
            if (!file) return;
            await performDeltaUpload(file, 'target');
            e.target.value = '';
        });

        async function performDeltaUpload(file, type) {
            if (deltaStatus) deltaStatus.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Uploading & processing…';
            const formData = new FormData();
            formData.append('jobId', JOB_ID);
            formData.append('file', file);

            const url = type === 'source'
                ? '@Url.Action("DeltaUploadSource", "Reports")'
                : '@Url.Action("DeltaUploadTargetSchema", "Reports")';

            try {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': getCsrfToken() },
                    body: formData
                });
                const result = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(result.error || `HTTP ${res.status}`);
                if (deltaStatus) {
                    deltaStatus.innerHTML = `<span class="text-success">
                        <i class="fas fa-check-circle me-1"></i>
                        <strong>${escHtml(result.fileName)}</strong> uploaded.
                        Rows Added: ${result.rowsAdded ?? 0} |
                        Mappings Updated: ${result.mappingsUpdated ?? 0} |
                        Time: ${(result.timeProcessedMs ?? 0).toFixed(0)}ms
                    </span>`;
                }
                // Refresh after 3s
                setTimeout(() => window.location.reload(), 3000);
            } catch (err) {
                if (deltaStatus) deltaStatus.innerHTML = `<span class="text-danger"><i class="fas fa-times-circle me-1"></i>${escHtml(err.message)}</span>`;
            }
        }

        // ═══════════════════════════════════════════════════════════════
        // ENHANCEMENT 2 — Reconciliation Configuration
        // ═══════════════════════════════════════════════════════════════

        let reconFields = [];
        let reconLoaded = false;

        document.getElementById('tab-reconciliation')?.addEventListener('shown.bs.tab', () => { if (!reconLoaded) loadReconConfig(); });
        document.getElementById('suggestReconFieldsBtn')?.addEventListener('click', loadReconConfig);
        document.getElementById('refreshReconBtn')?.addEventListener('click', loadReconConfig);

        async function loadReconConfig() {
            const tbody = document.getElementById('reconFieldsTbody');
            tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin me-1"></i>Loading…</td></tr>';
            try {
                const res = await fetch(`@Url.Action("GetReconciliationConfig","Reports")?jobId=${JOB_ID}`);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                reconFields = (data.fields ?? []).map((f, i) => ({...f, priority: f.priority || i + 1, validationType: f.validationType || 'COUNT'}));
                renderReconFields();
                reconLoaded = true;
                // Also load dashboard
                loadReconDashboard();
            } catch (e) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center text-danger py-3">${escHtml(e.message)}</td></tr>`;
            }
        }

        async function loadReconDashboard() {
            try {
                const res = await fetch(`@Url.Action("GetReconciliationDashboard","Reports")?jobId=${JOB_ID}`);
                if (!res.ok) return;
                const d = await res.json();
                document.getElementById('reconFieldsSelected').textContent = d.fieldsSelected ?? '—';
                document.getElementById('reconCoverage').textContent = d.coveragePercent != null ? `${d.coveragePercent}%` : '—';
                document.getElementById('reconMatched').textContent = d.matchedRecords ?? '—';
                document.getElementById('reconFailed').textContent = d.failedRecords ?? '—';
            } catch {}
        }

        function renderReconFields() {
            const tbody = document.getElementById('reconFieldsTbody');
            tbody.innerHTML = '';
            if (!reconFields.length) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-3">No reconciliation fields configured yet.</td></tr>';
                return;
            }
            reconFields.sort((a, b) => a.priority - b.priority).forEach((f, i) => {
                const vt = (f.validationType || 'COUNT').toUpperCase();
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="text-muted small">${i + 1}</td>
                    <td><input type="text" class="form-control form-control-sm recon-field-name" value="${escHtml(f.fieldName)}" /></td>
                    <td>
                        <select class="form-select form-select-sm recon-validation-type" style="width:100px">
                            <option value="COUNT" ${vt === 'COUNT' ? 'selected' : ''}>COUNT</option>
                            <option value="SUM" ${vt === 'SUM' ? 'selected' : ''}>SUM</option>
                        </select>
                    </td>
                    <td><input type="number" class="form-control form-control-sm recon-priority" value="${f.priority}" min="1" style="width:70px" /></td>
                    <td class="text-center"><input type="checkbox" class="form-check-input recon-mandatory" ${f.isMandatory ? 'checked' : ''} /></td>
                    <td><span class="badge bg-light text-dark border">${escHtml(f.reason || '')}</span></td>
                    <td class="small text-muted">${f.confidence != null ? Number(f.confidence).toFixed(2) : '—'}</td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger recon-remove-btn"><i class="fas fa-trash"></i></button></td>`;
                tr.querySelector('.recon-remove-btn').addEventListener('click', () => { tr.remove(); collectReconFields(); });
                tbody.appendChild(tr);
            });
        }

        function collectReconFields() {
            reconFields = [...document.getElementById('reconFieldsTbody').querySelectorAll('tr')].map((tr, i) => ({
                fieldName: tr.querySelector('.recon-field-name')?.value ?? '',
                priority: parseInt(tr.querySelector('.recon-priority')?.value ?? i + 1),
                isMandatory: tr.querySelector('.recon-mandatory')?.checked ?? false,
                validationType: tr.querySelector('.recon-validation-type')?.value ?? 'COUNT',
                reason: 'User Configured',
                confidence: null
            })).filter(f => f.fieldName);
        }

        document.getElementById('addReconFieldBtn')?.addEventListener('click', () => {
            reconFields.push({ fieldName: '', priority: reconFields.length + 1, isMandatory: false, validationType: 'COUNT', reason: 'User Added', confidence: null });
            renderReconFields();
        });

        document.getElementById('saveReconConfigBtn')?.addEventListener('click', async () => {
            collectReconFields();
            const btn = document.getElementById('saveReconConfigBtn');
            const status = document.getElementById('reconStatus');
            btn.disabled = true;
            status.textContent = 'Saving…';
            try {
                const res = await fetch(`@Url.Action("SaveReconciliationConfig","Reports")?jobId=${encodeURIComponent(JOB_ID)}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                    body: JSON.stringify({ fields: reconFields })
                });
                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    throw new Error(err.error || `HTTP ${res.status}`);
                }
                const result = await res.json();
                status.innerHTML = `<span class="text-success"><i class="fas fa-check me-1"></i>Saved ${result.saved} field(s). Keys: ${(result.reconciliationKeys ?? []).join(', ')}</span>`;
                loadReconDashboard();
            } catch (e) { status.innerHTML = `<span class="text-danger">${escHtml(e.message)}</span>`; }
            finally { btn.disabled = false; }
        });

        document.getElementById('downloadReconJsonBtn')?.addEventListener('click', async () => {
            collectReconFields();
            const config = { reconciliationKeys: reconFields.filter(f => f.fieldName).map(f => f.fieldName) };
            const blob = new Blob([JSON.stringify(config, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = 'reconciliation_config.json'; a.click();
            URL.revokeObjectURL(url);
        });

        // ═══════════════════════════════════════════════════════════════
        // ENHANCEMENT 3 — Transformation Overrides
        // ═══════════════════════════════════════════════════════════════

        let overrideData = [];
        let overrideCatalog = [];

        document.getElementById('loadOverridesBtn')?.addEventListener('click', loadOverrides);

        async function loadOverrides() {
            const tbody = document.getElementById('overridesTbody');
            tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin me-1"></i>Loading…</td></tr>';
            try {
                const res = await fetch(`@Url.Action("GetTransformationOverrides","Reports")?jobId=${JOB_ID}`);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                overrideData = data.overrides ?? [];
                overrideCatalog = data.catalog ?? [];
                renderOverrides();
            } catch (e) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center text-danger py-3">${escHtml(e.message)}</td></tr>`;
            }
        }

        function renderOverrides() {
            const tbody = document.getElementById('overridesTbody');
            tbody.innerHTML = '';
            if (!overrideData.length) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">No transformations found.</td></tr>';
                return;
            }
            overrideData.forEach((o, i) => {
                const tr = document.createElement('tr');
                const catalogOptions = overrideCatalog.map(c =>
                    `<option value="${escHtml(c)}" ${c === o.overrideTransformation ? 'selected' : ''}>${escHtml(c)}</option>`).join('');
                const confClass = o.confidence >= 0.90 ? 'text-success' : o.confidence >= 0.70 ? 'text-warning' : 'text-danger';
                const statusBadge = o.status === 'User_Override'
                    ? '<span class="badge bg-primary">Overridden</span>'
                    : o.status === 'Approved'
                        ? '<span class="badge bg-success">Approved</span>'
                        : '<span class="badge bg-secondary">AI Suggested</span>';
                tr.innerHTML = `
                    <td><code class="small">${escHtml(o.targetField)}</code></td>
                    <td class="small text-muted">${escHtml(o.sourceField)}</td>
                    <td><span class="badge bg-light text-dark border">${escHtml(o.suggestedTransformation)}</span></td>
                    <td class="${confClass} small">${Number(o.confidence).toFixed(2)}</td>
                    <td>
                        <select class="form-select form-select-sm override-select" data-index="${i}">
                            <option value="">— Keep AI Suggested —</option>
                            ${catalogOptions}
                        </select>
                    </td>
                    <td>
                        <input type="text" class="form-control form-control-sm override-expression" data-index="${i}"
                            value="${escHtml(o.customExpression ?? '')}"
                            placeholder="e.g. LEFT(source,10)" ${o.overrideTransformation === 'CUSTOM' || o.overrideTransformation === 'CONCAT' ? '' : 'disabled'} />
                    </td>
                    <td>${statusBadge}</td>`;
                // Enable expression when CUSTOM or CONCAT is selected
                const sel = tr.querySelector('.override-select');
                const expr = tr.querySelector('.override-expression');
                sel?.addEventListener('change', () => {
                    expr.disabled = !(sel.value === 'CUSTOM' || sel.value === 'CONCAT' || sel.value === 'HARDCODED');
                    if (expr.disabled) expr.value = '';
                });
                tbody.appendChild(tr);
            });
        }

        document.getElementById('saveOverridesBtn')?.addEventListener('click', async () => {
            const btn = document.getElementById('saveOverridesBtn');
            btn.disabled = true;
            // Collect overrides
            const rows = [...document.getElementById('overridesTbody').querySelectorAll('tr')];
            const overrides = overrideData.map((o, i) => {
                const row = rows[i];
                const sel = row?.querySelector('.override-select');
                const expr = row?.querySelector('.override-expression');
                return {
                    ...o,
                    overrideTransformation: sel?.value ?? '',
                    customExpression: expr?.value ?? ''
                };
            });
            try {
                const res = await fetch(`@Url.Action("SaveTransformationOverrides","Reports")?jobId=${encodeURIComponent(JOB_ID)}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                    body: JSON.stringify({ overrides })
                });
                if (!res.ok) {
                    const err = await res.json().catch(() => ({}));
                    throw new Error(err.error || `HTTP ${res.status}`);
                }
                const result = await res.json();
                const statusEl = document.getElementById('overridesSaveStatus');
                if (statusEl) statusEl.innerHTML = `<span class="text-success"><i class="fas fa-check-circle me-1"></i>Saved — ${result.overridden} override(s) applied.</span>`;
                setTimeout(() => { if (statusEl) statusEl.innerHTML = ''; }, 5000);
                loadOverrides();
            } catch (e) {
                const statusEl = document.getElementById('overridesSaveStatus');
                if (statusEl) statusEl.innerHTML = `<span class="text-danger"><i class="fas fa-times-circle me-1"></i>Save failed: ${escHtml(e.message)}</span>`;
            }
            finally { btn.disabled = false; }
        });

    })();
    </script>
}
