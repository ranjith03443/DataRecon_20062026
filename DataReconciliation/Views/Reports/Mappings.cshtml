@model DataReconciliation.Domain.Models.FinalMappingConfig
@{
    ViewData["Title"] = "Mapping Workbench";
    var jobId = ViewBag.JobId as string ?? "";
    var sourceFields = ViewBag.SourceFields as List<string> ?? new List<string>();
    var valueMappingTemplates = ViewBag.ValueMappingTemplates as List<DataReconciliation.Application.DTOs.ValueMappingTemplateInfoDto> ?? new List<DataReconciliation.Application.DTOs.ValueMappingTemplateInfoDto>();
    var hasUploadedValueMappingSeed = ViewBag.HasUploadedValueMappingSeed as bool? ?? false;
    var uploadedValueMappingSeedName = ViewBag.UploadedValueMappingSeedName as string ?? "";
}

<div class="d-flex align-items-center mb-3">
    <a asp-controller="Workflow" asp-action="Details" asp-route-jobId="@jobId" class="btn btn-outline-secondary me-3">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h2 class="mb-0"><i class="fas fa-tools me-2 text-secondary"></i>Mapping Workbench</h2>
        <code class="text-muted small">@jobId</code>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null)
{
    <div class="alert alert-warning"><i class="fas fa-exclamation-circle me-2"></i>Mapping consolidation has not run yet.</div>
}
else
{
    <!-- ─── Tab navigation ─────────────────────────────────── -->
    <ul class="nav nav-tabs border-bottom-0" id="workbenchTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-structural" data-bs-toggle="tab" data-bs-target="#pane-structural"
                    type="button" role="tab">
                <i class="fas fa-link me-1"></i>Structural Mapping
                <span class="badge bg-secondary ms-1">@Model.Mappings.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-valuemapping" data-bs-toggle="tab" data-bs-target="#pane-valuemapping"
                    type="button" role="tab">
                <i class="fas fa-exchange-alt me-1"></i>Value Mapping
                <span class="badge bg-info ms-1" id="vmCandidateBadge">…</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-transformations" data-bs-toggle="tab" data-bs-target="#pane-transformations"
                    type="button" role="tab">
                <i class="fas fa-magic me-1"></i>Transformations
                <span class="badge bg-secondary ms-1">@Model.Mappings.Count(m => m.Transformations.Any(t => !string.Equals(t.Operation,"HARDCODED_VALUE",StringComparison.OrdinalIgnoreCase)))</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-reconciliation" data-bs-toggle="tab" data-bs-target="#pane-reconciliation"
                    type="button" role="tab">
                <i class="fas fa-balance-scale me-1"></i>Reconciliation
            </button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom bg-white p-3 mb-3" id="workbenchTabContent">

        <!-- ═══════════════════════════════════════════════════
             TAB 1 – STRUCTURAL MAPPING
        ════════════════════════════════════════════════════ -->
        <div class="tab-pane fade show active" id="pane-structural" role="tabpanel">

            <!-- KPI cards -->
            <div class="row mb-3 g-2">
                <div class="col-6 col-md-3">
                    <div class="card text-center h-100"><div class="card-body py-2">
                        <div class="fs-3 fw-bold">@Model.Mappings.Count</div>
                        <div class="small text-muted">Total Fields</div>
                    </div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center h-100 border-success"><div class="card-body py-2">
                        <div class="fs-3 fw-bold text-success">@Model.Mappings.Count(m => m.Status.ToString() != "UNRESOLVED")</div>
                        <div class="small text-muted">Mapped</div>
                    </div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center h-100 border-danger"><div class="card-body py-2">
                        <div class="fs-3 fw-bold text-danger">@Model.Mappings.Count(m => m.Status.ToString() == "UNRESOLVED")</div>
                        <div class="small text-muted">Unresolved</div>
                    </div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center h-100 border-warning"><div class="card-body py-2">
                        <div class="fs-3 fw-bold text-warning">@Model.Mappings.Count(m => m.Confidence < 0.70)</div>
                        <div class="small text-muted">Low Confidence</div>
                    </div></div>
                </div>
            </div>

            <!-- Enhancement 1: Delta File Upload Buttons -->
            <div class="d-flex gap-2 flex-wrap mb-3 align-items-center">
                <button type="button" class="btn btn-sm btn-outline-success" id="deltaUploadSourceBtn">
                    <i class="fas fa-file-upload me-1"></i>Upload Additional Source File
                </button>
                <button type="button" class="btn btn-sm btn-outline-info" id="deltaUploadTargetBtn">
                    <i class="fas fa-file-upload me-1"></i>Upload Updated Target Schema
                </button>
                <span id="deltaUploadStatus" class="small text-muted"></span>
            </div>
            <input type="file" class="d-none" id="deltaSourceFileInput" accept=".csv,.xlsx,.xls,.json,.txt" />
            <input type="file" class="d-none" id="deltaTargetFileInput" accept=".csv,.xlsx,.xls" />

            @if (!sourceFields.Any())
            {
                <div class="alert alert-info small py-2">
                    <i class="fas fa-info-circle me-1"></i>
                    Source schema profile not found — source field dropdowns show only currently mapped values.
                    Run <strong>Source Schema Profiling</strong> to populate all available source fields.
                </div>
            }

            <!-- Template loader + confidence legend -->
            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <select class="form-select form-select-sm" id="templateSelect" style="min-width: 220px;">
                        <option value="">Select a template…</option>
                        @foreach (var template in valueMappingTemplates)
                        {
                            <option value="@template.TemplateName">@template.TemplateName</option>
                        }
                        @if (hasUploadedValueMappingSeed)
                        {
                            <option value="__uploaded_seed__">&#128206; @uploadedValueMappingSeedName (uploaded seed)</option>
                        }
                    </select>
                    <button type="button" class="btn btn-sm btn-outline-info" id="loadTemplateBtn">
                        <i class="fas fa-folder-open me-1"></i>Load Template
                    </button>
                </div>
                <div class="text-muted small">
                    <span class="badge bg-success me-1">●</span>≥0.90
                    <span class="badge bg-warning text-dark me-1 ms-2">●</span>0.70–0.89
                    <span class="badge bg-danger me-1 ms-2">●</span>&lt;0.70
                </div>
            </div>

            <!-- Mapping edit form -->
            <form asp-controller="Reports" asp-action="SaveMappings" method="post" id="mappingsForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="jobId" value="@jobId" />
                <div class="card">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
                        <h6 class="mb-0"><i class="fas fa-table me-1"></i>Mappings</h6>
                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            <a class="btn btn-sm btn-outline-secondary"
                               asp-controller="Reports" asp-action="DownloadStructuralMapping"
                               asp-route-jobId="@jobId">
                                <i class="fas fa-file-arrow-down me-1"></i>Download Mapping
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="collapse" data-bs-target="#uploadMappingPanel">
                                <i class="fas fa-file-arrow-up me-1"></i>Upload Edited Mapping
                            </button>
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="fas fa-save me-1"></i>Save Changes
                            </button>
                        </div>
                    </div>
                    @* Upload Mapping panel — must NOT be a nested form (breaks outer mappingsForm) *@
                    <div class="collapse" id="uploadMappingPanel">
                        <div class="p-3 border-bottom bg-light">
                            <p class="small text-muted mb-2">
                                <i class="fas fa-info-circle me-1"></i>
                                Download the Excel, edit source fields and merge rules offline, then re-upload to save.
                                Each target field needs one PRIMARY row; add FALLBACK or CONCAT rows for extra sources.
                            </p>
                            <div class="row g-2 align-items-end">
                                <div class="col-auto flex-grow-1">
                                    <input type="file" id="importMappingFileInput" class="form-control form-control-sm"
                                           accept=".xlsx,.xls" />
                                </div>
                                <div class="col-auto">
                                    <button type="button" id="importMappingSubmitBtn" class="btn btn-primary btn-sm">
                                        <i class="fas fa-upload me-1"></i>Import &amp; Save
                                    </button>
                                </div>
                                <div class="col-12">
                                    <span id="importMappingStatus" class="small"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:36px">#</th>
                                    <th>Target Field</th>
                                    <th title="Source vs Target field length">Length <i class="fas fa-info-circle text-muted" style="font-size:.7rem"></i></th>
                                    <th>Source Field <small class="text-muted fw-normal">(editable)</small></th>
                                    <th>Dataset</th>
                                    <th title="Match origin">Status / Method <i class="fas fa-info-circle text-muted" style="font-size:.7rem"></i></th>
                                    <th>Confidence</th>
                                    <th>Value Mapping</th>
                                    <th style="width:110px">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (mapping, idx) in Model.Mappings
                                    .OrderBy(m => m.TargetField, StringComparer.OrdinalIgnoreCase)
                                    .Select((m, i) => (m, i)))
                                {
                                    var isFixedValue = string.Equals(mapping.MatchSource, "Fixed Value", StringComparison.OrdinalIgnoreCase);
                                    var statusLabel = mapping.Status.ToString() switch
                                    {
                                        _ when isFixedValue       => "Fixed Value",
                                        "AUTO_MATCHED"            => "Deterministic",
                                        "AI_MATCHED"              => "AI Matched",
                                        "MANUAL_REVIEW_REQUIRED"  => "Needs Review",
                                        "CONFIRMED"               => "Confirmed",
                                        "UNRESOLVED"              => "Unresolved",
                                        _                         => mapping.Status.ToString()
                                    };
                                    var statusClass = mapping.Status.ToString() switch
                                    {
                                        _ when isFixedValue       => "bg-dark",
                                        "AUTO_MATCHED"            => "bg-success",
                                        "AI_MATCHED"              => "bg-warning text-dark",
                                        "MANUAL_REVIEW_REQUIRED"  => "bg-orange text-dark",
                                        "CONFIRMED"               => "bg-success",
                                        "UNRESOLVED"              => "bg-danger",
                                        _                         => "bg-secondary"
                                    };
                                    var confValue = mapping.Confidence;
                                    var confClass = confValue >= 0.90 ? "text-success fw-bold"
                                        : confValue >= 0.70 ? "text-warning fw-bold"
                                        : "text-danger fw-bold";
                                    var isUnresolved = mapping.Status.ToString() == "UNRESOLVED";

                                    var sourceFieldLengths = ViewBag.SourceFieldLengths as Dictionary<string, int> ?? new Dictionary<string, int>();
                                    var targetFieldLengths = ViewBag.TargetFieldLengths as Dictionary<string, int?> ?? new Dictionary<string, int?>();
                                    var sourceLength = !string.IsNullOrEmpty(mapping.SourceField) && sourceFieldLengths.ContainsKey(mapping.SourceField)
                                        ? sourceFieldLengths[mapping.SourceField] : (int?)null;
                                    var targetLength = targetFieldLengths.ContainsKey(mapping.TargetField)
                                        ? targetFieldLengths[mapping.TargetField] : (int?)null;

                                    string lengthDisplay; string lengthClass;
                                    if (sourceLength.HasValue && targetLength.HasValue)
                                    {
                                        if (sourceLength > targetLength) { lengthDisplay = $"S{sourceLength}>T{targetLength}"; lengthClass = "bg-warning text-dark"; }
                                        else if (sourceLength < targetLength) { lengthDisplay = $"S{sourceLength}<T{targetLength}"; lengthClass = "bg-info text-white"; }
                                        else { lengthDisplay = $"={sourceLength}"; lengthClass = "bg-success text-white"; }
                                    }
                                    else if (sourceLength.HasValue) { lengthDisplay = $"S:{sourceLength}"; lengthClass = "bg-light text-dark"; }
                                    else if (targetLength.HasValue) { lengthDisplay = $"T:{targetLength}"; lengthClass = "bg-light text-dark"; }
                                    else { lengthDisplay = "—"; lengthClass = "text-muted"; }

                                    var (msIcon, msClass, msLabel) = mapping.MatchSource switch
                                    {
                                        "Prior Mapping Data"                 => ("fa-history",       "bg-info text-white",      "Historic"),
                                        "AI Inference"                       => ("fa-robot",         "bg-purple text-white",    "AI"),
                                        "Fixed Value"                        => ("fa-lock",          "bg-dark text-white",      "Fixed"),
                                        "Exact Name Match"                   => ("fa-check-circle",  "bg-success text-white",   "Exact"),
                                        "Normalised Name Match"              => ("fa-equals",        "bg-secondary text-white", "Normalised"),
                                        "Abbreviation (Built-in Dictionary)" => ("fa-book",          "bg-secondary text-white", "Dictionary"),
                                        "Partial Name Match"                 => ("fa-adjust",        "bg-secondary text-white", "Partial"),
                                        "Fuzzy Name Match"                   => ("fa-tilde",         "bg-secondary text-white", "Fuzzy"),
                                        "AI-enriched Exact Match"            => ("fa-brain",         "bg-warning text-dark",    "AI+Exact"),
                                        "AI-enriched Name Match"             => ("fa-brain",         "bg-warning text-dark",    "AI+Name"),
                                        "AI-enriched Abbreviation"           => ("fa-brain",         "bg-warning text-dark",    "AI+Dict"),
                                        "AI-enriched Match"                  => ("fa-brain",         "bg-warning text-dark",    "AI Match"),
                                        "Rule-based Match"                   => ("fa-magic",         "bg-secondary text-white", "Rule-based"),
                                        "Manual Confirmation"                => ("fa-user-check",    "bg-primary text-white",   "Manual"),
                                        "historical"                         => ("fa-history",       "bg-info text-white",      "Historic"),
                                        "exact_match"                        => ("fa-check-circle",  "bg-success text-white",   "Exact"),
                                        "normalized_match"                   => ("fa-equals",        "bg-secondary text-white", "Normalised"),
                                        "normalized_abbreviation"            => ("fa-book",          "bg-secondary text-white", "Dictionary"),
                                        "partial_match"                      => ("fa-adjust",        "bg-secondary text-white", "Partial"),
                                        "fuzzy_match"                        => ("fa-tilde",         "bg-secondary text-white", "Fuzzy"),
                                        "hardcoded_value"                    => ("fa-lock",          "bg-dark text-white",      "Fixed"),
                                        "unresolved" or "Unresolved"         => ("fa-exclamation",   "bg-danger text-white",    "Unresolved"),
                                        var t when t != null && t.StartsWith("semantic_") => ("fa-brain", "bg-warning text-dark", "AI Match"),
                                        _ => ("fa-question", "bg-light text-dark", string.IsNullOrWhiteSpace(mapping.MatchSource) ? "Unknown" : mapping.MatchSource)
                                    };

                                    var valueMappingRule = mapping.Transformations.FirstOrDefault(t => string.Equals(t.Operation, "VALUE_MAPPING", StringComparison.OrdinalIgnoreCase));
                                    var valueMappingCount = valueMappingRule?.Rules?.Count ?? 0;
                                    var serializedRules = valueMappingRule?.Rules == null ? "{}" : System.Text.Json.JsonSerializer.Serialize(valueMappingRule.Rules);

                                    <tr class="mapping-row" data-target-field="@mapping.TargetField">
                                        <td class="text-center text-muted">@(idx+1)</td>
                                        <td>
                                            <code class="small">@mapping.TargetField</code>
                                            <input type="hidden" name="Updates[@idx].TargetField" value="@mapping.TargetField" />
                                        </td>
                                        <td>
                                            @if (lengthDisplay != "—")
                                            {
                                                <span class="badge @lengthClass" style="font-size:.7rem">@lengthDisplay</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @* Primary source field *@
                                            <div class="d-flex align-items-center gap-1 mb-1">
                                                <span class="badge bg-primary" style="font-size:.65rem;white-space:nowrap">PRIMARY</span>
                                                <select name="Updates[@idx].SourceField"
                                                        class="form-select form-select-sm @(isUnresolved ? "border-danger" : "")">
                                                    <option value="">-- Unresolved --</option>
                                                    @foreach (var sf in sourceFields)
                                                    {
                                                        <option value="@sf" selected="@(sf == mapping.SourceField ? "selected" : null)">@sf</option>
                                                    }
                                                    @if (!string.IsNullOrEmpty(mapping.SourceField) && !sourceFields.Contains(mapping.SourceField))
                                                    {
                                                        <option value="@mapping.SourceField" selected>@mapping.SourceField</option>
                                                    }
                                                </select>
                                            </div>
                                            @* Additional source fields *@
                                            <div class="additional-sources-container" data-idx="@idx">
                                                @for (int ai = 0; ai < mapping.AdditionalSources.Count; ai++)
                                                {
                                                    var addSrc = mapping.AdditionalSources[ai];
                                                    var addRuleColors = new Dictionary<string,string>{["FALLBACK"]="bg-secondary",["CONCAT"]="bg-info"};
                                                    var addRuleColor = addRuleColors.GetValueOrDefault(addSrc.MergeRule, "bg-secondary");
                                                    <div class="d-flex align-items-center gap-1 mb-1 additional-source-row">
                                                        <select name="Updates[@idx].AdditionalSources[@ai].MergeRule"
                                                                class="form-select form-select-sm add-rule-sel" style="width:90px;min-width:90px">
                                                            <option value="FALLBACK" selected="@(addSrc.MergeRule=="FALLBACK"?"selected":null)">FALLBACK</option>
                                                            <option value="CONCAT"   selected="@(addSrc.MergeRule=="CONCAT"?"selected":null)">CONCAT</option>
                                                        </select>
                                                        <select name="Updates[@idx].AdditionalSources[@ai].SourceField"
                                                                class="form-select form-select-sm add-field-sel">
                                                            <option value="">-- Select --</option>
                                                            @foreach (var sf in sourceFields)
                                                            {
                                                                <option value="@sf" selected="@(sf == addSrc.SourceField ? "selected" : null)">@sf</option>
                                                            }
                                                            @if (!string.IsNullOrEmpty(addSrc.SourceField) && !sourceFields.Contains(addSrc.SourceField))
                                                            {
                                                                <option value="@addSrc.SourceField" selected>@addSrc.SourceField</option>
                                                            }
                                                        </select>
                                                        <button type="button" class="btn btn-sm btn-outline-danger remove-add-src" title="Remove">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-secondary add-source-btn"
                                                    data-idx="@idx" style="font-size:.7rem">
                                                <i class="fas fa-plus me-1"></i>Add Source
                                            </button>
                                        </td>
                                        <td class="text-muted small">@(mapping.SourceDataset ?? "—")</td>
                                        <td>
                                            <span class="badge @statusClass me-1">@statusLabel</span>
                                            <span class="badge @msClass" title="@mapping.MatchSource"><i class="fas @msIcon me-1"></i>@msLabel</span>
                                        </td>
                                        <td class="@confClass small">@mapping.Confidence.ToString("F2")</td>
                                        <td>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-info value-mapping-btn"
                                                    data-target-field="@mapping.TargetField"
                                                    data-source-field="@mapping.SourceField"
                                                    data-rules='@System.Net.WebUtility.HtmlEncode(serializedRules)'
                                                    data-template-name="@mapping.TargetField">
                                                <i class="fas fa-list-check me-1"></i>@(valueMappingCount > 0 ? $"{valueMappingCount} rules" : "Manage")
                                            </button>
                                        </td>
                                        <td>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-warning re-ai-btn mb-1"
                                                    data-target-field="@mapping.TargetField"
                                                    title="Re-run AI matching for this field">
                                                <i class="fas fa-robot"></i>
                                            </button>
                                            <div class="form-check d-inline-flex align-items-center gap-1 ms-1">
                                                <input class="form-check-input mapping-delete-checkbox"
                                                       type="checkbox"
                                                       id="del_@idx"
                                                       name="Updates[@idx].Delete"
                                                       value="true"
                                                       data-row-index="@idx" />
                                                <label class="form-check-label small text-danger" for="del_@idx">Del</label>
                                            </div>
                                            <input type="hidden" name="Updates[@idx].Delete" value="false" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-save me-1"></i>Save Mapping Changes
                        </button>
                        <span class="text-muted small">After saving, use <strong>Generate Output File</strong> below.</span>
                    </div>
                </div>
            </form>
        </div>

        <!-- ═══════════════════════════════════════════════════
             TAB 2 – VALUE MAPPING
        ════════════════════════════════════════════════════ -->
        <div class="tab-pane fade" id="pane-valuemapping" role="tabpanel">

            <div class="row mb-3 g-2">
                <div class="col-6 col-md-3">
                    <div class="card text-center h-100"><div class="card-body py-2">
                        <div class="fs-3 fw-bold" id="vmKpiTotal">—</div>
                        <div class="small text-muted">Candidates</div>
                    </div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center h-100 border-success"><div class="card-body py-2">
                        <div class="fs-3 fw-bold text-success" id="vmKpiComplete">—</div>
                        <div class="small text-muted">Complete</div>
                    </div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center h-100 border-warning"><div class="card-body py-2">
                        <div class="fs-3 fw-bold text-warning" id="vmKpiPartial">—</div>
                        <div class="small text-muted">Partial</div>
                    </div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center h-100 border-secondary"><div class="card-body py-2">
                        <div class="fs-3 fw-bold text-secondary" id="vmKpiPending">—</div>
                        <div class="small text-muted">Pending</div>
                    </div></div>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap mb-3 align-items-center">
                <!-- Enhancement 1: Delta upload buttons in Value Mapping tab -->
                <button type="button" class="btn btn-sm btn-outline-success delta-upload-src-vm">
                    <i class="fas fa-file-upload me-1"></i>Upload Additional Source File
                </button>
                <button type="button" class="btn btn-sm btn-outline-info delta-upload-tgt-vm">
                    <i class="fas fa-file-upload me-1"></i>Upload Updated Target Schema
                </button>
                <span class="border-start ms-2 ps-2"></span>
                <form asp-controller="Reports" asp-action="DiscoverValueMappings" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="jobId" value="@jobId" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-search me-1"></i>Discover Candidates
                    </button>
                </form>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="refreshVmBtn">
                    <i class="fas fa-sync me-1"></i>Refresh
                </button>
                <button type="button" class="btn btn-sm btn-outline-info" id="genVmTemplateBtn">
                    <i class="fas fa-robot me-1"></i>Generate AI Value Mapping Template
                </button>
                <span id="vmAiStatus" class="small text-muted"></span>
            </div>

            <div class="card">
                <div class="card-header bg-white py-2">
                    <h6 class="mb-0"><i class="fas fa-exchange-alt me-1"></i>Value Mapping Candidates</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Source Field</th>
                                <th>Target Field</th>
                                <th>Distinct Values</th>
                                <th>Rules</th>
                                <th>Coverage</th>
                                <th>Status</th>
                                <th>Reason</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="vmCandidatesTbody">
                            <tr><td colspan="8" class="text-center text-muted py-4">
                                <i class="fas fa-spinner fa-spin me-2"></i>Loading candidates…
                            </td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════
             TAB 3 – TRANSFORMATIONS
        ════════════════════════════════════════════════════ -->
        <div class="tab-pane fade" id="pane-transformations" role="tabpanel">

            @{
                var allTransformRows = Model.Mappings
                    .SelectMany(m => m.Transformations
                        .Where(t => !string.Equals(t.Operation, "HARDCODED_VALUE", StringComparison.OrdinalIgnoreCase))
                        .Select(t => new { Mapping = m, Rule = t }))
                    .ToList();
                var aiSuggestedCount = allTransformRows.Count(r => r.Rule.AIParameters != null && r.Rule.AIParameters.Any());
            }

            <div class="row mb-3 g-2">
                <div class="col-6 col-md-4">
                    <div class="card text-center h-100"><div class="card-body py-2">
                        <div class="fs-3 fw-bold">@allTransformRows.Count</div>
                        <div class="small text-muted">Transformation Rules</div>
                    </div></div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="card text-center h-100 border-warning"><div class="card-body py-2">
                        <div class="fs-3 fw-bold text-warning">@aiSuggestedCount</div>
                        <div class="small text-muted"><i class="fas fa-robot me-1"></i>AI Suggested</div>
                    </div></div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="card text-center h-100 border-info"><div class="card-body py-2">
                        <div class="fs-3 fw-bold text-info">@(allTransformRows.Count - aiSuggestedCount)</div>
                        <div class="small text-muted">Rule-based</div>
                    </div></div>
                </div>
            </div>

            <div class="d-flex gap-2 mb-3 align-items-center flex-wrap">
                <span class="text-muted small">Preview output sample:</span>
                <button type="button" class="btn btn-sm btn-outline-secondary preview-btn" data-count="10">10 rows</button>
                <button type="button" class="btn btn-sm btn-outline-secondary preview-btn" data-count="20">20 rows</button>
                <button type="button" class="btn btn-sm btn-outline-secondary preview-btn" data-count="50">50 rows</button>
                <span id="previewStatus" class="small text-muted"></span>
            </div>

            <div class="card">
                <div class="card-header bg-white py-2">
                    <h6 class="mb-0"><i class="fas fa-magic me-1"></i>All Transformation Rules</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Target Field</th>
                                <th>Source Field</th>
                                <th>Transformation Rule</th>
                                <th>Actual Field Change</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int txIdx = 0;}
                            @foreach (var m in Model.Mappings)
                            {
                                var visibleTx = m.Transformations
                                    .Where(t => !string.Equals(t.Operation, "HARDCODED_VALUE", StringComparison.OrdinalIgnoreCase))
                                    .ToList();
                                if (!visibleTx.Any()) continue;
                                foreach (var rule in visibleTx)
                                {
                                    txIdx++;
                                    var operation = (rule.Operation ?? "").ToUpperInvariant();
                                    var changeDescription = operation switch
                                    {
                                        "FIXED_WIDTH_FORMATTING"   => $"Pad/truncate to {rule.FixedWidth?.ToString() ?? "target width"} chars, {(rule.Alignment ?? "LEFT").ToUpperInvariant()} aligned, fill '{(string.IsNullOrEmpty(rule.PadCharacter) ? " " : rule.PadCharacter)}'",
                                        "DATE_FORMATTING"          => $"Convert date → {(string.IsNullOrWhiteSpace(rule.Format) ? "target date format" : rule.Format)}",
                                        "DECIMAL_FORMATTING"       => "Normalize decimal representation for target output",
                                        "VALUE_MAPPING"            => $"Map source values using {(rule.Rules?.Count ?? 0)} rule(s)",
                                        "MASKING"                  => string.IsNullOrWhiteSpace(rule.MaskPattern) ? "Mask sensitive value" : $"Mask value → {rule.MaskPattern}",
                                        "DEFAULT_VALUE_ASSIGNMENT" => string.IsNullOrWhiteSpace(rule.DefaultValue) ? "Assign default when empty" : $"Default: '{rule.DefaultValue}'",
                                        "DATATYPE_CONVERSION"      => "Convert value to target datatype",
                                        "UPPERCASE"                => "Convert text → UPPERCASE",
                                        "LOWERCASE"                => "Convert text → lowercase",
                                        "TRIM"                     => "Trim leading/trailing spaces",
                                        _ => rule.AIParameters != null && rule.AIParameters.Any()
                                            ? "Apply AI-derived transformation"
                                            : "Apply configured rule"
                                    };
                                    <tr>
                                        <td class="text-muted small">@txIdx</td>
                                        <td><code class="small">@m.TargetField</code></td>
                                        <td class="text-muted small">@(m.SourceField ?? "—")</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@rule.Operation</span>
                                            @if (rule.AIParameters != null && rule.AIParameters.Any())
                                            {
                                                <span class="badge bg-warning text-dark ms-1"><i class="fas fa-robot me-1"></i>AI</span>
                                            }
                                        </td>
                                        <td class="small text-muted">@changeDescription</td>
                                    </tr>
                                }
                            }
                            @if (txIdx == 0)
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">No transformations configured.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Enhancement 3: Transformation Override Grid -->
            <div class="card mt-3">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="fas fa-edit me-1"></i>Transformation Overrides</h6>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span id="overridesSaveStatus" class="small"></span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="loadOverridesBtn">
                            <i class="fas fa-sync me-1"></i>Load
                        </button>
                        <button type="button" class="btn btn-sm btn-primary" id="saveOverridesBtn">
                            <i class="fas fa-save me-1"></i>Save Overrides
                        </button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Target Field</th>
                                <th>Source Field</th>
                                <th>Suggested Transformation</th>
                                <th>Confidence</th>
                                <th>Override Transformation</th>
                                <th>Custom Expression</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="overridesTbody">
                            <tr><td colspan="7" class="text-center text-muted py-3">Click <strong>Load</strong> to view transformation overrides.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════
             TAB 4 – RECONCILIATION (Enhancement 2)
        ════════════════════════════════════════════════════ -->
        <div class="tab-pane fade" id="pane-reconciliation" role="tabpanel">

            <!-- Recon Dashboard KPIs -->
            <div class="row mb-3 g-2">
                <div class="col-6 col-md-3">
                    <div class="card text-center h-100"><div class="card-body py-2">
                        <div class="fs-3 fw-bold" id="reconFieldsSelected">—</div>
                        <div class="small text-muted">Fields Selected</div>
                    </div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center h-100 border-info"><div class="card-body py-2">
                        <div class="fs-3 fw-bold text-info" id="reconCoverage">—</div>
                        <div class="small text-muted">Coverage %</div>
                    </div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center h-100 border-success"><div class="card-body py-2">
                        <div class="fs-3 fw-bold text-success" id="reconMatched">—</div>
                        <div class="small text-muted">Matched Records</div>
                    </div></div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center h-100 border-danger"><div class="card-body py-2">
                        <div class="fs-3 fw-bold text-danger" id="reconFailed">—</div>
                        <div class="small text-muted">Failed Records</div>
                    </div></div>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap mb-3 align-items-center">
                <button type="button" class="btn btn-sm btn-outline-primary" id="suggestReconFieldsBtn">
                    <i class="fas fa-lightbulb me-1"></i>Suggest Reconciliation Fields
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="refreshReconBtn">
                    <i class="fas fa-sync me-1"></i>Refresh
                </button>
                <button type="button" class="btn btn-sm btn-success" id="saveReconConfigBtn">
                    <i class="fas fa-save me-1"></i>Save Configuration
                </button>
                <button type="button" class="btn btn-sm btn-outline-info" id="downloadReconJsonBtn">
                    <i class="fas fa-download me-1"></i>Download reconciliation_config.json
                </button>
                <span id="reconStatus" class="small text-muted"></span>
            </div>

            <div class="card">
                <div class="card-header bg-white py-2">
                    <h6 class="mb-0"><i class="fas fa-balance-scale me-1"></i>Reconciliation Fields</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px">#</th>
                                <th>Field Name</th>
                                <th>Validation Type</th>
                                <th>Priority</th>
                                <th>Mandatory</th>
                                <th>Reason</th>
                                <th>Confidence</th>
                                <th style="width:80px">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="reconFieldsTbody">
                            <tr><td colspan="8" class="text-center text-muted py-4">
                                Click <strong>Suggest Reconciliation Fields</strong> to begin.
                            </td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white py-2">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="addReconFieldBtn">
                        <i class="fas fa-plus me-1"></i>Add Field
                    </button>
                </div>
            </div>
        </div>

    </div><!-- /tab-content -->

    <!-- ─── Generate Output File ──────────────────────────── -->
    <div class="card border-success mb-3">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h6 class="mb-1 text-success"><i class="fas fa-file-export me-1"></i>Generate Output File</h6>
                <p class="mb-0 small text-muted">
                    Once you are happy with the mappings, click to run steps 11–14:
                    Transformation → Target File Generation → Reconciliation → Reporting.
                    The <code>target_output.dat</code> will be available on the Workflow Details page.
                </p>
            </div>
            <form asp-controller="Reports" asp-action="GenerateFile" method="post" class="ms-3 flex-shrink-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="jobId" value="@jobId" />
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-cogs me-1"></i>Generate Output File
                </button>
            </form>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════
         MODAL 1 – Value Mapping Editor
    ═══════════════════════════════════════════════════════ -->
    <div class="modal fade" id="valueMappingModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title mb-0">Value Mapping Editor</h5>
                        <small class="text-muted" id="valueMappingSubtitle"></small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" id="valueMappingForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <input type="hidden" name="jobId" value="@jobId" />
                        <input type="hidden" name="TargetField" id="valueMappingTargetField" />
                        <input type="hidden" name="SourceField" id="valueMappingSourceField" />
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Template name</label>
                                <input type="text" class="form-control" name="TemplateName" id="valueMappingTemplateName" placeholder="e.g. Default_Status_Code_Template" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Load template</label>
                                <select class="form-select" id="modalTemplateSelect">
                                    <option value="">-- Select existing template --</option>
                                    @foreach (var template in valueMappingTemplates)
                                    {
                                        <option value="@template.TemplateName">@template.TemplateName</option>
                                    }
                                    @if (hasUploadedValueMappingSeed)
                                    {
                                        <option value="__uploaded_seed__">&#128206; @uploadedValueMappingSeedName (uploaded seed)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label class="form-label">Import rules from Excel (.xlsx/.xls)</label>
                                <input type="file" class="form-control" id="valueMappingExcelFile" accept=".xlsx,.xls" />
                                <div class="form-text">Expected columns: Code description, Ext Code, Short description, Long description.</div>
                            </div>
                            <div class="col-md-4 d-flex align-items-end gap-2">
                                <button type="button" class="btn btn-outline-success w-100" id="importExcelMappingBtn">
                                    <i class="fas fa-file-import me-1"></i>Import From Excel
                                </button>
                                <button type="button" class="btn btn-outline-primary w-100" id="importUploadedExcelMappingBtn" @(hasUploadedValueMappingSeed ? "" : "disabled")>
                                    <i class="fas fa-database me-1"></i>Import Uploaded Excel
                                </button>
                            </div>
                            <div class="col-12">
                                <div class="small text-muted" id="excelImportStatus"></div>
                                @if (hasUploadedValueMappingSeed)
                                {
                                    <div class="small text-muted mt-1">Uploaded at ingestion: <code>@uploadedValueMappingSeedName</code></div>
                                }
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <h6 class="mb-0">Mappings</h6>
                                <small class="text-muted">Disable a row to exclude it from the saved mapping set.</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="loadModalTemplateBtn">
                                    <i class="fas fa-folder-open me-1"></i>Load Selected Template
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" id="addValueMappingRowBtn">
                                    <i class="fas fa-plus me-1"></i>Add Row
                                </button>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle" id="valueMappingTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:22%">Source Value</th>
                                        <th style="width:22%">Target Value</th>
                                        <th style="width:8%">Enabled</th>
                                        <th>Notes</th>
                                        <th style="width:6%"></th>
                                    </tr>
                                </thead>
                                <tbody id="valueMappingTbody"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <div class="text-muted small" id="valueMappingCountLabel">0 active rules</div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-outline-secondary" formaction="@Url.Action("SaveValueMappingTemplate", "Reports")">
                                <i class="fas fa-floppy-disk me-1"></i>Save Template
                            </button>
                            <button type="submit" class="btn btn-primary" formaction="@Url.Action("SaveValueMappings", "Reports")">
                                <i class="fas fa-save me-1"></i>Save Value Mappings
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════
         MODAL 2 – Value Mapping Candidate Review
    ═══════════════════════════════════════════════════════ -->
    <div class="modal fade" id="vmReviewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title mb-0"><i class="fas fa-exchange-alt me-2"></i>Review Value Mapping</h5>
                        <small class="text-muted" id="vmReviewSubtitle"></small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
