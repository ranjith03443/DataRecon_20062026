@model DataReconciliation.Application.DTOs.MainframeArtifactPageDto

@{
    ViewData["Title"] = "Mainframe Development Centre";
    var assetModel = Model.AssetPageModel ?? new DataReconciliation.Application.DTOs.MainframeAssetPageDto { JobId = Model.JobId };
    var ar = assetModel.AssetResult;
    var activeTab = "tab-artifacts";
    if (TempData["AssetSuccess"] != null || TempData["AssetError"] != null || ar != null)
        activeTab = "tab-assets";
}

@* â”€â”€ Page header â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1"><i class="fas fa-terminal me-2 text-primary"></i>Mainframe Development Centre</h2>
        <p class="text-muted mb-0">Generate artifacts, build mainframe assets, and get AI-powered development guidance - all from a single job.</p>
    </div>
</div>

@* â”€â”€ Global alerts â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["AssetSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-robot me-2"></i>@TempData["AssetSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["AssetError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["AssetError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* â”€â”€ Shared Job ID context banner â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
<div class="card mb-3 border-0 bg-light">
    <div class="card-body py-2 px-3 d-flex align-items-center gap-3 flex-wrap">
        <i class="fas fa-briefcase text-secondary"></i>
        <span class="text-muted small fw-semibold">Active Job</span>
        <code id="sharedJobIdDisplay" class="fs-6">
            @(Model.Result?.JobId ?? assetModel?.AssetResult?.JobId ?? Model.JobId ?? "-")
        </code>
        @{
            var hasJob = !string.IsNullOrWhiteSpace(Model.Result?.JobId ?? assetModel?.AssetResult?.JobId ?? Model.JobId);
        }
        @if (hasJob)
        {
            <span class="badge bg-success"><i class="fas fa-circle-check me-1"></i>Job loaded</span>
        }
        else
        {
            <span class="badge bg-secondary">Enter a Job ID in any tab below</span>
        }
    </div>
</div>

@* â”€â”€ Main tab navigation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
<ul class="nav nav-tabs nav-fill mb-0" id="mainTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "tab-artifacts" ? "active" : "")"
                id="btn-tab-artifacts" data-bs-toggle="tab" data-bs-target="#tab-artifacts"
                type="button" role="tab">
            <i class="fas fa-file-code me-2 text-primary"></i>
            <span class="fw-semibold">Mainframe Artifacts</span>
            <br /><small class="fw-normal text-muted">Copybook | Spec | JSON</small>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "tab-assets" ? "active" : "")"
                id="btn-tab-assets" data-bs-toggle="tab" data-bs-target="#tab-assets"
                type="button" role="tab">
            <i class="fas fa-layer-group me-2 text-info"></i>
            <span class="fw-semibold">Mainframe Assets</span>
            <br /><small class="fw-normal text-muted">COBOL | JCL | Samples</small>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link"
                id="btn-tab-agent" data-bs-toggle="tab" data-bs-target="#tab-agent"
                type="button" role="tab">
            <i class="fas fa-brain me-2 text-warning"></i>
            <span class="fw-semibold">AI Development Agent</span>
            <br /><small class="fw-normal text-muted">Explain | Review | Enhance | Document</small>
        </button>
    </li>
</ul>

<div class="tab-content border border-top-0 rounded-bottom bg-white shadow-sm" id="mainTabContent">

    @* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       TAB 1 â€” MAINFRAME ARTIFACTS (deterministic: copybook, spec, JSON)
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
    <div class="tab-pane fade @(activeTab == "tab-artifacts" ? "show active" : "")"
         id="tab-artifacts" role="tabpanel">
        <div class="p-4">
            <div class="row g-4">
                <div class="col-lg-3">
                    <h6 class="text-primary fw-semibold mb-2"><i class="fas fa-info-circle me-1"></i>What it generates</h6>
                    <ul class="list-unstyled small text-muted mb-3">
                        <li class="mb-1"><i class="fas fa-file-code text-success me-2"></i>Copybook <code>.cpy</code></li>
                        <li class="mb-1"><i class="fas fa-file-lines text-secondary me-2"></i>Specification <code>.txt</code></li>
                        <li class="mb-1"><i class="fas fa-file-alt text-warning me-2"></i>Summary manifest <code>.json</code></li>
                    </ul>
                    <p class="small text-muted mb-0">
                        <i class="fas fa-gears me-1"></i><strong>Deterministic.</strong> Reads target schema only. No AI involved.
                    </p>
                </div>
                <div class="col-lg-9">
                    <form asp-action="Generate" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="JobId" class="form-label fw-semibold">Job ID</label>
                                <input asp-for="JobId" class="form-control job-id-input" placeholder="JOB_20260527071213_96B921" />
                                <span asp-validation-for="JobId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Request.RecordName" class="form-label fw-semibold">Record name</label>
                                <input asp-for="Request.RecordName" class="form-control" placeholder="CUSTOMER_MASTER" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Request.ApplicationName" class="form-label fw-semibold">Application name</label>
                                <input asp-for="Request.ApplicationName" class="form-control" placeholder="MAINFRAME_APP" />
                            </div>
                        </div>
                        <div class="form-check form-switch my-3">
                            <input asp-for="Request.IncludeComments" class="form-check-input" />
                            <label asp-for="Request.IncludeComments" class="form-check-label">Include comments in artifacts</label>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-gears me-2"></i>Generate Mainframe Artifacts
                        </button>
                    </form>
                </div>
            </div>

            @if (Model.Result != null)
            {
                <hr class="my-4" />
                <div class="mb-3">
                    <h5 class="mb-0"><i class="fas fa-check-circle text-success me-2"></i>Generated Artifacts</h5>
                    <small class="text-muted">
                        Job: <strong>@Model.Result.JobId</strong> |
                        Record: <strong>@Model.Result.RecordName</strong> Â·
                        @Model.Result.Fields.Count fields Â·
                        @Model.Result.GeneratedAt.ToString("yyyy-MM-dd HH:mm") UTC
                    </small>
                </div>
                <div class="d-flex gap-2 flex-wrap mb-4">
                    <a class="btn btn-success"
                       asp-action="Download" asp-route-jobId="@Model.Result.JobId"
                       asp-route-fileName="@Model.Result.CopybookFileName">
                        <i class="fas fa-download me-2"></i>Copybook (.cpy)
                    </a>
                    <a class="btn btn-outline-success"
                       asp-action="Download" asp-route-jobId="@Model.Result.JobId"
                       asp-route-fileName="@Model.Result.SpecificationFileName">
                        <i class="fas fa-download me-2"></i>Specification (.txt)
                    </a>
                    <a class="btn btn-outline-secondary"
                       asp-action="Download" asp-route-jobId="@Model.Result.JobId"
                       asp-route-fileName="@Model.Result.SummaryFileName">
                        <i class="fas fa-download me-2"></i>Summary (.json)
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th><th>Field</th><th>Data Type</th>
                                <th>Length</th><th>Picture</th><th>Source Field</th><th>Justification</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var field in Model.Result.Fields.OrderBy(f => f.ColumnOrder))
                            {
                                <tr>
                                    <td class="text-muted">@(field.ColumnOrder + 1)</td>
                                    <td><code>@field.FieldName</code></td>
                                    <td>@field.DataType</td>
                                    <td>@(field.Length?.ToString() ?? "-")</td>
                                    <td><code>@field.PictureClause</code></td>
                                    <td>@(field.SourceField ?? "-")</td>
                                    <td>@field.Justification</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       TAB 2 â€” MAINFRAME ASSETS (deterministic: COBOL, JCL, samples)
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
    <div class="tab-pane fade @(activeTab == "tab-assets" ? "show active" : "")"
         id="tab-assets" role="tabpanel">
        <div class="p-4">
            <div class="row g-4">
                <div class="col-lg-3">
                    <h6 class="text-info fw-semibold mb-2"><i class="fas fa-info-circle me-1"></i>What it generates</h6>
                    <ul class="list-unstyled small text-muted mb-3">
                        <li class="mb-1"><i class="fas fa-file-code text-success me-2"></i>Copybook <code>.cpy</code></li>
                        <li class="mb-1"><i class="fas fa-code text-success me-2"></i>COBOL <code>.cbl</code></li>
                        <li class="mb-1"><i class="fas fa-server text-primary me-2"></i>JCL <code>.jcl</code></li>
                        <li class="mb-1"><i class="fas fa-file-lines text-secondary me-2"></i>Technical spec <code>.txt</code></li>
                        <li class="mb-1"><i class="fas fa-database text-info me-2"></i>Sample records <code>.dat</code></li>
                    </ul>
                    <p class="small text-muted mb-2">
                        <i class="fas fa-gears me-1"></i><strong>Deterministic.</strong> Reads schema, mappings and value mappings. No AI involved.
                    </p>
                    <span class="badge bg-warning text-dark small">
                        <i class="fas fa-triangle-exclamation me-1"></i>COBOL &amp; JCL - Review Required
                    </span>
                </div>
                <div class="col-lg-9">
                    <form asp-action="GenerateAssets" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Job ID</label>
                                <input name="JobId" id="assetJobId" class="form-control job-id-input"
                                       value="@(Model.Result?.JobId ?? Model.JobId)"
                                       placeholder="JOB_20260527071213_96B921" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Record Name</label>
                                <input name="Request.RecordName" class="form-control"
                                       value="@(ar?.RecordName ?? Model.Result?.RecordName ?? "CUSTOMER_MASTER")" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Application Name</label>
                                <input name="Request.ApplicationName" class="form-control"
                                       value="@(ar?.ApplicationName ?? Model.Result?.ApplicationName ?? "MAINFRAME_APP")" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Program Name <small class="text-muted">(max 8)</small></label>
                                <input name="Request.ProgramName" class="form-control"
                                       value="@(ar?.ProgramName ?? "CUSTMSTR")" maxlength="8" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Job Name <small class="text-muted">(max 8)</small></label>
                                <input name="Request.JobName" class="form-control"
                                       value="@(ar?.JobName ?? "CUSTLOAD")" maxlength="8" />
                            </div>
                        </div>
                        <h6 class="fw-semibold text-muted mb-2">Select outputs</h6>
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Request.GenerateCopybook" value="true" checked id="chkCopybook" />
                                    <input type="hidden" name="Request.GenerateCopybook" value="false" />
                                    <label class="form-check-label small" for="chkCopybook"><i class="fas fa-file-code text-success me-1"></i>Copybook (.cpy)</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Request.GenerateCobolSkeleton" value="true" checked id="chkCobol" />
                                    <input type="hidden" name="Request.GenerateCobolSkeleton" value="false" />
                                    <label class="form-check-label small" for="chkCobol"><i class="fas fa-code text-success me-1"></i>COBOL (.cbl)</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Request.GenerateJclSkeleton" value="true" checked id="chkJcl" />
                                    <input type="hidden" name="Request.GenerateJclSkeleton" value="false" />
                                    <label class="form-check-label small" for="chkJcl"><i class="fas fa-server text-primary me-1"></i>JCL (.jcl)</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Request.GenerateTechnicalSpec" value="true" checked id="chkSpec" />
                                    <input type="hidden" name="Request.GenerateTechnicalSpec" value="false" />
                                    <label class="form-check-label small" for="chkSpec"><i class="fas fa-file-lines text-secondary me-1"></i>Technical Spec (.txt)</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Request.GenerateSampleRecords" value="true" checked id="chkSamples" />
                                    <input type="hidden" name="Request.GenerateSampleRecords" value="false" />
                                    <label class="form-check-label small" for="chkSamples"><i class="fas fa-database text-info me-1"></i>Sample Records (.dat)</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-0 text-muted">Sample record count</label>
                                <select name="Request.SampleRecordCount" class="form-select form-select-sm">
                                    <option value="10" selected>10</option>
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-info text-white">
                            <i class="fas fa-layer-group me-2"></i>Generate Mainframe Assets
                        </button>
                    </form>
                </div>
            </div>

            @if (ar != null)
            {
                <hr class="my-4" />
                <div class="mb-3">
                    <h5 class="mb-0"><i class="fas fa-check-circle text-success me-2"></i>Generated Assets</h5>
                    <small class="text-muted">
                        Job: <strong>@ar.JobId</strong> |
                        Record: <strong>@ar.RecordName</strong> |
                        Program: <strong>@ar.ProgramName</strong> |
                        @ar.Fields.Count fields | @ar.TotalRecordLength bytes |
                        @ar.GeneratedAt.ToString("yyyy-MM-dd HH:mm") UTC
                    </small>
                </div>
                <div class="alert alert-warning py-2 mb-3 d-flex align-items-center gap-2">
                    <i class="fas fa-triangle-exclamation flex-shrink-0"></i>
                    <span>Please review the generated COBOL and JCL files before executing.</span>
                </div>
                <div class="d-flex gap-2 flex-wrap mb-4">
                    @if (ar.CopybookFileName != null)
                    {
                        <a class="btn btn-success btn-sm"
                           asp-action="DownloadAsset" asp-route-jobId="@ar.JobId" asp-route-fileName="@ar.CopybookFileName">
                            <i class="fas fa-download me-1"></i>Copybook (.cpy)
                        </a>
                    }
                    @if (ar.CobolSkeletonFileName != null)
                    {
                        <a class="btn btn-outline-success btn-sm"
                           asp-action="DownloadAsset" asp-route-jobId="@ar.JobId" asp-route-fileName="@ar.CobolSkeletonFileName">
                            <i class="fas fa-download me-1"></i>COBOL (.cbl)
                        </a>
                    }
                    @if (ar.JclSkeletonFileName != null)
                    {
                        <a class="btn btn-outline-primary btn-sm"
                           asp-action="DownloadAsset" asp-route-jobId="@ar.JobId" asp-route-fileName="@ar.JclSkeletonFileName">
                            <i class="fas fa-download me-1"></i>JCL (.jcl)
                        </a>
                    }
                    @if (ar.TechnicalSpecFileName != null)
                    {
                        <a class="btn btn-outline-secondary btn-sm"
                           asp-action="DownloadAsset" asp-route-jobId="@ar.JobId" asp-route-fileName="@ar.TechnicalSpecFileName">
                            <i class="fas fa-download me-1"></i>Technical Spec (.txt)
                        </a>
                    }
                    @if (ar.SampleRecordsFileName != null)
                    {
                        <a class="btn btn-outline-info btn-sm"
                           asp-action="DownloadAsset" asp-route-jobId="@ar.JobId" asp-route-fileName="@ar.SampleRecordsFileName">
                            <i class="fas fa-download me-1"></i>Sample Records (.dat)
                        </a>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th><th>Field Name</th><th>COBOL Name</th>
                                <th>Type</th><th>Len</th><th>Start</th><th>PIC</th><th>Source Field</th><th>Req</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in ar.Fields.OrderBy(x => x.ColumnOrder))
                            {
                                <tr>
                                    <td class="text-muted">@(f.ColumnOrder + 1)</td>
                                    <td><code>@f.FieldName</code></td>
                                    <td><code>@f.CobolFieldName</code></td>
                                    <td><span class="badge bg-light text-dark border">@f.DataType</span></td>
                                    <td>@(f.Length?.ToString() ?? "-")</td>
                                    <td>@f.StartPosition</td>
                                    <td><code>@f.PictureClause</code></td>
                                    <td>@(f.SourceField ?? "-")</td>
                                    <td>@(f.IsRequired ? "Y" : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       TAB 3 â€” AI DEVELOPMENT AGENT
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
