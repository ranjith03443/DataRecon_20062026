</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // â”€â”€ Tab persistence via URL hash â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        (function () {
            const hash = window.location.hash;
            if (hash) {
                const btn = document.querySelector(`[data-bs-target="${hash}"]`);
                if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
            }
            document.querySelectorAll('#mainTabs button').forEach(btn => {
                btn.addEventListener('shown.bs.tab', e => {
                    history.replaceState(null, '', e.target.dataset.bsTarget);
                });
            });
        })();

        // â”€â”€ Sync Job ID across all tabs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        document.querySelectorAll('.job-id-input').forEach(src => {
            src.addEventListener('input', () => {
                const val = src.value;
                document.querySelectorAll('.job-id-input').forEach(t => { if (t !== src) t.value = val; });
                const disp = document.getElementById('sharedJobIdDisplay');
                if (disp) disp.textContent = val || '-';
            });
        });

        // â”€â”€ AI Agent â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        let _lastAiResult = null;

        document.querySelectorAll('.agent-btn').forEach(btn => {
            btn.addEventListener('click', () => runAgent(btn.dataset.agent, btn));
        });

        async function runAgent(agentType, srcBtn) {
            const jobId = document.getElementById('aiAgentJobId').value.trim();
            if (!jobId) { showAgentError('Please enter a Job ID before running an AI Agent action.'); return; }

            document.querySelectorAll('.agent-btn').forEach(b => b.classList.remove('active-agent'));
            if (srcBtn) srcBtn.classList.add('active-agent');

            setAgentLoading(true);
            hideAgentError();
            document.getElementById('aiAgentResult').classList.add('d-none');

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const body = new URLSearchParams({ jobId, agentType, __RequestVerificationToken: token });

            try {
                const resp = await fetch('@Url.Action("RunAgentAction", "Mainframe")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body.toString()
                });
                const data = await resp.json();
                if (!data.success) { showAgentError(data.errorMessage || 'AI Agent returned an error.'); return; }
                _lastAiResult = data.result;
                renderAgentResult(data.result);
            } catch (err) {
                showAgentError('Network error: ' + err.message);
            } finally {
                setAgentLoading(false);
            }
        }

        function unescapeNewlines(s) {
            // Guard against literal \n strings that survive JSON transport issues
            return typeof s === 'string' ? s.replace(/\\n/g, '\n').replace(/\\t/g, '\t') : s;
        }

        // ── Section metadata: icon + accent colour per ALL-CAPS heading keyword ────
        function sectionMeta(header) {
            const h = (header || '').toUpperCase();
            if (!h) return { icon: 'fa-circle-info', color: '#6c757d' };
            if (h.match(/PURPOSE|OVERVIEW|PROGRAM/))        return { icon: 'fa-bullseye',              color: '#0d6efd' };
            if (h.match(/INPUT|OUTPUT|FILE|I\/O|RECORD/))   return { icon: 'fa-arrow-right-arrow-left', color: '#198754' };
            if (h.match(/TRANSFORM|CONVERSION|PROCESS/))    return { icon: 'fa-gears',                 color: '#fd7e14' };
            if (h.match(/FIELD|MAPPING|COLUMN|LAYOUT/))     return { icon: 'fa-link',                  color: '#6f42c1' };
            if (h.match(/VALIDAT/))                          return { icon: 'fa-shield-halved',          color: '#0dcaf0' };
            if (h.match(/ERROR|EXCEPTION|ABEND|FAULT/))     return { icon: 'fa-triangle-exclamation',  color: '#dc3545' };
            if (h.match(/BUSINESS|LOGIC|RULE/))             return { icon: 'fa-building',              color: '#6610f2' };
            if (h.match(/PERFORMANCE|OPTIM/))               return { icon: 'fa-bolt',                  color: '#20c997' };
            if (h.match(/STRUCT|COPYBOOK/))                 return { icon: 'fa-layer-group',           color: '#0dcaf0' };
            if (h.match(/VALUE|CODE|LOOKUP|MAP/))           return { icon: 'fa-table',                 color: '#fd7e14' };
            if (h.match(/DOCUMENT|COMMENT|HEADER/))         return { icon: 'fa-book',                  color: '#6c757d' };
            if (h.match(/SUMMARY|CONCLUSION/))              return { icon: 'fa-clipboard-check',       color: '#198754' };
            if (h.match(/JCL|STEP|PROC|DD /))              return { icon: 'fa-server',                color: '#0d6efd' };
            return { icon: 'fa-circle-info', color: '#6c757d' };
        }

        // ── Parse structured text into [{header, content}] sections ──────────────
        function parseSections(text) {
            if (!text || !text.trim()) return [];
            // Split on blank lines to get paragraphs
            const paragraphs = text.split(/\n\n+/).map(p => p.trim()).filter(Boolean);
            // A section header is ALL-CAPS word(s) ending with colon at the start of a paragraph
            const headerRe = /^([A-Z][A-Z /\-&]{2,50}):\s*/;
            const sections = [];
            for (const para of paragraphs) {
                const m = headerRe.exec(para);
                if (m) {
                    sections.push({ header: m[1].trim(), content: para.slice(m[0].length).trim() });
                } else if (sections.length > 0) {
                    // Continuation paragraph — append to last section
                    sections[sections.length - 1].content += '\n\n' + para;
                } else {
                    sections.push({ header: '', content: para });
                }
            }
            return sections;
        }

        // ── Render plain text as HTML paragraphs (safe) ──────────────────────────
        function formatParagraphs(text) {
            if (!text) return '';
            return text.split(/\n\n+/)
                .map(p => `<p class="mb-2" style="line-height:1.7;">${escHtml(p.trim()).replace(/\n/g, '<br>')}</p>`)
                .join('');
        }

        // ── Build the full Summary tab HTML ──────────────────────────────────────
        function renderSummaryHtml(text, promptType) {
            const sections = parseSections(text);
            if (!sections.length) return `<p class="text-muted fst-italic small">No explanation returned for this agent type.</p>`;

            const noHeaders = sections.every(s => !s.header);
            let html = '';

            if (noHeaders) {
                // Unstructured text — render as readable paragraphs in a single card
                html = `<div class="p-1">${formatParagraphs(sections.map(s => s.content).join('\n\n'))}</div>`;
            } else {
                sections.forEach(sec => {
                    const meta = sectionMeta(sec.header);
                    if (!sec.header) {
                        // Preamble before first header
                        html += `<div class="mb-3 pb-2 text-muted small fst-italic">${formatParagraphs(sec.content)}</div>`;
                        return;
                    }
                    html += `
                    <div class="mb-3" style="border-left:3px solid ${meta.color};padding-left:14px;">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="fas ${meta.icon} fa-sm" style="color:${meta.color};width:14px;text-align:center;"></i>
                            <span class="fw-semibold text-uppercase small" style="color:${meta.color};letter-spacing:0.06em;">${escHtml(sec.header)}</span>
                        </div>
                        <div>${formatParagraphs(sec.content)}</div>
                    </div>`;
                });
            }

            // Governance notice pinned at the bottom
            html += `<div class="mt-3 pt-2 border-top">
                <span class="small text-muted fst-italic">
                    <i class="fas fa-robot me-1"></i>AI Generated Developer Guidance — Review Required before use in production.
                </span>
            </div>`;
            return html;
        }

        // ── Main render function ─────────────────────────────────────────────────
        function renderAgentResult(r) {
            const confPct   = Math.round((r.confidence || 0) * 100);
            const confLevel = r.confidenceLevel || '';
            const confColor = { HIGH: '#198754', MEDIUM: '#fd7e14', LOW: '#dc3545', INSUFFICIENT: '#6c757d' }[confLevel] || '#6c757d';
            const confBg    = { HIGH: 'bg-success', MEDIUM: 'bg-warning text-dark', LOW: 'bg-danger', INSUFFICIENT: 'bg-secondary' }[confLevel] || 'bg-secondary';

            // Header panel: accent border colour follows confidence level
            const header = document.getElementById('aiResultHeader');
            if (header) header.style.borderLeftColor = confColor;

            document.getElementById('aiResultAgentName').innerHTML =
                `<i class="fas fa-brain me-2" style="color:${confColor};"></i>${escHtml(r.agentName || 'AI Agent')}`;
            document.getElementById('aiConfidenceBadge').className = `badge rounded-pill ${confBg}`;
            document.getElementById('aiConfidenceBadge').textContent = `${confLevel} ${confPct}%`;
            document.getElementById('aiResultJobId').textContent   = r.jobId || '-';
            document.getElementById('aiResultTime').textContent    = r.responseTimeMs ? r.responseTimeMs.toFixed(0) + ' ms' : '-';

            const tokEl = document.getElementById('aiResultTokens');
            if (r.tokenUsage && r.tokenUsage.total_tokens > 0) {
                tokEl.innerHTML = `<i class="fas fa-coins me-1"></i>${r.tokenUsage.total_tokens.toLocaleString()} tokens`;
                tokEl.classList.remove('d-none');
            } else { tokEl.textContent = ''; }

            const bar = document.getElementById('aiConfidenceBar');
            bar.style.width   = confPct + '%';
            bar.className     = `progress-bar ${confBg.replace('text-dark', '')}`;
            document.getElementById('aiConfidencePct').textContent  = confPct + '%';
            document.getElementById('aiConfidencePct').style.color  = confColor;

            // ── Summary tab ──────────────────────────────────────────────────────
            const explanation = unescapeNewlines(r.businessExplanation) || '';
            document.getElementById('aiSummaryContent').innerHTML = renderSummaryHtml(explanation, r.promptType);

            // ── Code tab ─────────────────────────────────────────────────────────
            const codeEl   = document.getElementById('aiCodeContent');
            const noCodeEl = document.getElementById('aiNoCode');
            const codeBtnEl = document.getElementById('copyCodeBtn');
            if (r.generatedCode) {
                codeEl.textContent = unescapeNewlines(r.generatedCode);
                codeEl.classList.remove('d-none');
                noCodeEl.classList.add('d-none');
                if (codeBtnEl) codeBtnEl.classList.remove('d-none');
            } else {
                codeEl.classList.add('d-none');
                noCodeEl.classList.remove('d-none');
                if (codeBtnEl) codeBtnEl.classList.add('d-none');
            }

            // ── Recommendations tab ──────────────────────────────────────────────
            const recsEl   = document.getElementById('aiRecsContent');
            const noRecsEl = document.getElementById('aiNoRecs');
            const recs = r.recommendations || [];
            document.getElementById('tabRecsBadge').textContent = recs.length;
            document.getElementById('tabRecsBadge').className   = `badge ms-1 ${recs.length > 0 ? 'bg-primary' : 'bg-secondary'}`;
            if (recs.length > 0) {
                noRecsEl.classList.add('d-none');
                const sevIcon  = { HIGH: 'fa-circle-xmark text-danger', MEDIUM: 'fa-circle-exclamation text-warning', LOW: 'fa-circle-info text-info', INFO: 'fa-circle-info text-secondary' };
                const sevColor = { HIGH: 'danger', MEDIUM: 'warning', LOW: 'info', INFO: 'secondary' };
                recsEl.innerHTML = recs.map((rec, idx) => {
                    const icon = sevIcon[rec.severity] || 'fa-circle-info text-secondary';
                    const col  = sevColor[rec.severity] || 'secondary';
                    return `<div class="border rounded p-3 mb-2" style="border-left:3px solid var(--bs-${col}) !important;">
                        <div class="d-flex align-items-start gap-2">
                            <i class="fas ${icon} mt-1 flex-shrink-0" style="width:16px;"></i>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-${col} text-${col === 'warning' ? 'dark' : 'white'}" style="font-size:0.7rem;">${escHtml(rec.severity)}</span>
                                    <span class="text-muted small fw-semibold">${escHtml(rec.category || '')}</span>
                                    <span class="text-muted small ms-auto">#${idx + 1}</span>
                                </div>
                                <div class="mb-1">${escHtml(rec.message || '')}</div>
                                ${rec.suggestion ? `<div class="small rounded p-2 mt-1" style="background:#f8f9fa;"><i class="fas fa-lightbulb text-warning me-1"></i><em>${escHtml(rec.suggestion)}</em></div>` : ''}
                                ${rec.codeExample ? `<pre class="mt-2 p-2 rounded mb-0 bg-dark text-light" style="font-size:0.75rem;max-height:200px;overflow-y:auto;white-space:pre-wrap;">${escHtml(rec.codeExample)}</pre>` : ''}
                            </div>
                        </div>
                    </div>`;
                }).join('');
            } else {
                noRecsEl.classList.remove('d-none');
                recsEl.innerHTML = '';
            }

            // ── Warnings tab ─────────────────────────────────────────────────────
            const warnings = r.warnings || [];
            const warnBadge = document.getElementById('tabWarnBadge');
            const nonGovWarnings = warnings.filter(w => !w.startsWith('***'));
            warnBadge.classList.toggle('d-none', nonGovWarnings.length === 0);

            let warningsHtml = '';
            // Governance notice: all lines starting with ***
            const govLines = warnings.filter(w => w.startsWith('***'));
            if (govLines.length) {
                warningsHtml += `<div class="d-flex align-items-start gap-3 p-3 rounded mb-3" style="background:#fff8e1;border-left:4px solid #ffc107;">
                    <i class="fas fa-robot text-warning mt-1 flex-shrink-0 fs-5"></i>
                    <div>
                        <div class="fw-semibold mb-1" style="color:#856404;">AI Governance Notice</div>
                        ${govLines.map(l => `<div class="small" style="color:#856404;font-family:monospace;">${escHtml(l)}</div>`).join('')}
                    </div>
                </div>`;
            }
            nonGovWarnings.forEach(w => {
                warningsHtml += `<div class="alert alert-warning py-2 mb-2 small"><i class="fas fa-triangle-exclamation me-2"></i>${escHtml(w)}</div>`;
            });
            if (!warningsHtml) warningsHtml = '<p class="text-muted small">No warnings.</p>';
            document.getElementById('aiWarningsContent').innerHTML = warningsHtml;

            // Show result and scroll
            document.getElementById('aiAgentResult').classList.remove('d-none');
            document.getElementById('tab-summary-lnk').click();
            document.getElementById('aiAgentResult').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function copyCodeContent(btn) {
            const code = document.getElementById('aiCodeContent')?.textContent || '';
            navigator.clipboard.writeText(code).then(() => {
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check me-1"></i>Copied!';
                setTimeout(() => btn.innerHTML = orig, 2000);
            });
        }

        function setAgentLoading(on) {
            document.getElementById('aiAgentSpinner').classList.toggle('d-none', !on);
            document.querySelectorAll('.agent-btn').forEach(b => b.disabled = on);
        }
        function showAgentError(msg) {
            document.getElementById('aiAgentErrorMsg').textContent = msg;
            document.getElementById('aiAgentError').classList.remove('d-none');
        }
        function hideAgentError() { document.getElementById('aiAgentError').classList.add('d-none'); }
        function escHtml(str) {
            return str ? String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;') : '';
        }
        function buildExportText(r) {
            const lines = [
                '=====================================', 'MAINFRAME DEVELOPMENT AI AGENT REPORT',
                '=====================================',
                'AI Generated Developer Guidance | Review Required', '',
                'Agent      : ' + (r.agentName || ''), 'Job ID     : ' + (r.jobId || ''),
                'Confidence : ' + (r.confidenceLevel || '') + ' (' + ((r.confidence||0)*100).toFixed(0) + '%)', '',
            ];
            if (r.businessExplanation) lines.push('--- EXPLANATION ---', r.businessExplanation, '');
            if (r.generatedCode)       lines.push('--- GENERATED CODE ---', r.generatedCode, '');
            if (r.recommendations?.length) {
                lines.push('--- RECOMMENDATIONS ---');
                r.recommendations.forEach((rec, i) => {
                    lines.push(`[${i+1}] [${rec.severity}] ${rec.category}: ${rec.message}`);
                    if (rec.suggestion) lines.push('    Suggestion: ' + rec.suggestion);
                    if (rec.codeExample) lines.push('    Code:\n' + rec.codeExample);
                });
            }
            return lines.join('\n');
        }
        function copyAiResult() {
            if (!_lastAiResult) return;
            navigator.clipboard.writeText(buildExportText(_lastAiResult)).then(() => {
                const btn = event.target.closest('button');
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check me-1"></i>Copied!';
                setTimeout(() => btn.innerHTML = orig, 2000);
            });
        }
        function exportAiResultWord() {
            if (!_lastAiResult) return;
            const a = document.createElement('a');
            a.href = URL.createObjectURL(new Blob([buildExportText(_lastAiResult)], { type: 'application/msword' }));
            a.download = 'mainframe_ai_' + (_lastAiResult.jobId || 'export') + '.doc';
            a.click();
        }
    </script>
    <style>
        .agent-btn.active-agent { box-shadow: 0 0 0 3px rgba(13,110,253,.25); }
        #mainTabs .nav-link { border-radius: 0; padding: .75rem 1rem; }
        #mainTabs .nav-link.active { border-bottom-color: #fff; background: #fff; }
    </style>
}
