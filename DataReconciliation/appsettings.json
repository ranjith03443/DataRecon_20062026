{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=datareconciliation.db"
  },
  "WorkflowStorage": {
    "BasePath": "workflow"
  },
  "ValueMappingThreshold": 20,
  "AI": {
    "Enabled": true,
    "Provider": "PythonService",
    "ApiUrl": "https://api.openai.com/v1/chat/completions",
    "ApiKey": "",
    "Model": "gpt-3.5-turbo",
    "ConfidenceThreshold": {
      "AutoAccept": 0.90,
      "Warning": 0.70,
      "ManualReview": 0.0
    },
    "PythonService": {
      "BaseUrl": "http://localhost:8000",
      "MappingEndpoint": "/api/semantic-mapping",
      "EnrichmentEndpoint": "/api/semantic-enrichment",
      "RuleInferenceEndpoint": "/api/rule-inference",
      "TimeoutSeconds": 360
    }
  },
  "TargetFile": {
    "Format": "fixed_width",
    "Delimiter": ",",
    "IncludeHeader": true,
    "IncludeTrailer": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
