# ──────────────────────────────────────────────────────────────────────────
# Semantic Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────

# ── Azure OpenAI ────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ── OpenAI (alternative provider) ────────────────────────────────────────────
OPENAI_API_KEY=<your-openai-api-key>

# ── HuggingFace (future extensibility) ───────────────────────────────────────
HUGGINGFACE_TOKEN=<your-huggingface-token>

# ── Platform Security ────────────────────────────────────────────────────────
# Comma-separated list of valid API keys for production use
SEMANTIC_API_KEYS=demo-key-1,demo-key-2

# ── Runtime Configuration ────────────────────────────────────────────────────
ENVIRONMENT=dev
LOG_LEVEL=DEBUG

# ── Configuration Paths ───────────────────────────────────────────────────────
CONFIG_PATH=config
PROMPTS_PATH=prompts

# ── Provider Selection (can override config/models.yaml) ─────────────────────
LLM_PROVIDER=azure_openai
EMBEDDING_PROVIDER=azure_openai
